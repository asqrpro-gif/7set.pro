<%- include('admin_layout_header', { title: 'Дашборд', page: 'dashboard' }) %>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-4">
    <div class="bg-slate-800 rounded-lg p-2 md:p-3 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-[10px] md:text-xs font-medium">Всего карточек</p>
            <h3 class="text-lg md:text-xl font-bold text-white mt-0.5" id="stat-total">-</h3>
        </div>
        <div class="bg-blue-500/20 p-1.5 md:p-2 rounded"><i data-lucide="database" class="text-blue-400 w-4 h-4 md:w-5 md:h-5"></i></div>
    </div>
    <div class="bg-slate-800 rounded-lg p-2 md:p-3 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-[10px] md:text-xs font-medium">Опубликовано</p>
            <h3 class="text-lg md:text-xl font-bold text-green-400 mt-0.5" id="stat-published">-</h3>
        </div>
        <div class="bg-green-500/20 p-1.5 md:p-2 rounded"><i data-lucide="check-circle" class="text-green-400 w-4 h-4 md:w-5 md:h-5"></i></div>
    </div>
    <div class="bg-slate-800 rounded-lg p-2 md:p-3 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-[10px] md:text-xs font-medium">Отложено</p>
            <h3 class="text-lg md:text-xl font-bold text-yellow-400 mt-0.5" id="stat-scheduled">-</h3>
        </div>
        <div class="bg-yellow-500/20 p-1.5 md:p-2 rounded"><i data-lucide="clock" class="text-yellow-400 w-4 h-4 md:w-5 md:h-5"></i></div>
    </div>
    <div class="bg-slate-800 rounded-lg p-2 md:p-3 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-[10px] md:text-xs font-medium">За сегодня</p>
            <h3 class="text-lg md:text-xl font-bold text-purple-400 mt-0.5" id="stat-today">-</h3>
        </div>
        <div class="bg-purple-500/20 p-1.5 md:p-2 rounded"><i data-lucide="zap" class="text-purple-400 w-4 h-4 md:w-5 md:h-5"></i></div>
    </div>
</div>

<h2 class="text-base md:text-lg font-semibold text-white mb-2">Умный монитор Sitemap</h2>
<div class="bg-slate-800 rounded-lg p-3 md:p-4 border border-slate-700 shadow-sm mb-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Состояние -->
        <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2 text-slate-300 font-medium text-xs md:text-sm">
                <i data-lucide="map" class="w-4 h-4 text-blue-400"></i>
                Объем карты сайта
            </div>
            <div class="flex items-end gap-2">
                <span class="text-xl font-bold text-white"><%= typeof sitemapStats !== 'undefined' ? sitemapStats.urlCount.toLocaleString('ru-RU') : '0' %></span>
                <span class="text-slate-500 text-xs mb-1">/ <%= typeof sitemapStats !== 'undefined' ? sitemapStats.limit.toLocaleString('ru-RU') : '45 000' %></span>
            </div>
            <% if (typeof sitemapStats !== 'undefined' && sitemapStats.isIndex) { %>
                <span class="text-[10px] text-green-400 font-medium mt-1 bg-green-400/10 px-2 py-0.5 rounded w-fit">Разбито на <%= sitemapStats.chunksCount %> файлов (Index)</span>
            <% } else { %>
                <div class="w-full bg-slate-700 rounded-full h-1.5 mt-1">
                    <% const pct = typeof sitemapStats !== 'undefined' ? Math.min((sitemapStats.urlCount / sitemapStats.limit) * 100, 100) : 0; %>
                    <div class="bg-blue-500 h-1.5 rounded-full" style="width: <%= pct %>%"></div>
                </div>
            <% } %>
        </div>

        <!-- Чистота -->
        <div class="flex flex-col gap-1.5 border-t md:border-t-0 md:border-l border-slate-700 pt-3 md:pt-0 md:pl-4">
            <div class="flex items-center gap-2 text-slate-300 font-medium text-xs md:text-sm">
                <i data-lucide="shield-check" class="w-4 h-4 text-green-400"></i>
                Чистота ссылок
            </div>
            <div class="flex flex-col gap-1 mt-1 text-xs">
                <div class="flex items-center gap-1.5 text-slate-400">
                    <i data-lucide="check" class="w-3.5 h-3.5 text-green-500"></i>
                    Только опубликованные
                </div>
                <div class="flex items-center gap-1.5 text-slate-400">
                    <i data-lucide="check" class="w-3.5 h-3.5 text-green-500"></i>
                    Без статуса DANGER
                </div>
                <div class="flex items-center gap-1.5 text-slate-400">
                    <i data-lucide="check" class="w-3.5 h-3.5 text-green-500"></i>
                    Без пустых (UNSUPPORTED)
                </div>
            </div>
        </div>

        <!-- Управление -->
        <div class="flex flex-col gap-1.5 border-t md:border-t-0 md:border-l border-slate-700 pt-3 md:pt-0 md:pl-4 justify-between">
            <div>
                <div class="flex items-center gap-2 text-slate-300 font-medium text-xs md:text-sm">
                    <i data-lucide="satellite-dish" class="w-4 h-4 text-purple-400"></i>
                    Связь с поисковиками
                </div>
                <div class="text-xs text-slate-400 mt-1.5">
                    Последний PING: <br>
                    <span id="sitemap-last-ping" class="text-white font-medium"><%= typeof sitemapStats !== 'undefined' && sitemapStats.lastPing ? sitemapStats.lastPing : 'Никогда' %></span>
                </div>
            </div>
            <button onclick="pingSitemap(this)" class="mt-2 w-full bg-slate-700 hover:bg-slate-600 border border-slate-600 text-white text-xs font-medium py-1.5 px-3 rounded flex items-center justify-center gap-2 transition-colors">
                <i data-lucide="send" class="w-3.5 h-3.5"></i>
                <span>Оповестить ботов</span>
            </button>
        </div>
    </div>
</div>

<h2 class="text-base md:text-lg font-semibold text-white mb-2">Радар Перелинковки (Orphans & 404)</h2>
<div class="bg-slate-800 rounded-lg p-3 md:p-4 border border-slate-700 shadow-sm mb-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Битые ссылки -->
        <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2 text-slate-300 font-medium text-xs md:text-sm">
                <i data-lucide="link-2-off" class="w-4 h-4 text-red-400"></i>
                Битые ссылки (404)
            </div>
            <div class="flex items-end gap-2">
                <span class="text-xl font-bold <%= (typeof linksStats !== 'undefined' && linksStats.brokenLinksCount > 0) ? 'text-red-400' : 'text-green-400' %>">
                    <%= typeof linksStats !== 'undefined' ? linksStats.brokenLinksCount : '0' %>
                </span>
                <span class="text-slate-500 text-xs mb-1">внутренних 404 ошибок</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-1">Ссылки, ведущие на удаленные или несуществующие карточки.</div>
        </div>

        <!-- Управление -->
        <div class="flex flex-col gap-1.5 border-t md:border-t-0 md:border-l border-slate-700 pt-3 md:pt-0 md:pl-4 justify-between">
            <div>
                <div class="flex items-center gap-2 text-slate-300 font-medium text-xs md:text-sm">
                    <i data-lucide="activity" class="w-4 h-4 text-blue-400"></i>
                    Статус сканирования
                </div>
                <div class="text-xs text-slate-400 mt-1.5">
                    Последний скан: <br>
                    <span class="text-white font-medium"><%= typeof linksStats !== 'undefined' && linksStats.lastScan ? linksStats.lastScan : 'Никогда' %></span>
                </div>
            </div>
            <div class="mt-2 flex gap-2 w-full">
                <a href="/admin/seo-ops?mode=links" class="flex-1 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-white text-xs font-medium py-1.5 px-3 rounded flex items-center justify-center gap-2 transition-colors">
                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                    <span>Смотреть</span>
                </a>
            </div>
        </div>
    </div>
</div>

<h2 class="text-base md:text-lg font-semibold text-white mb-2">Управление</h2>
<div class="flex flex-col gap-2">
    <% scripts.forEach(script => { 
        const safeId = script.file.replace(/\./g, '-'); 
    %>
        <div class="bg-slate-800 border border-slate-700 rounded-lg overflow-hidden shadow-sm">
            <!-- Header (Accordion Trigger) -->
            <div class="p-2 md:p-3 hover:bg-slate-700/50 transition-colors flex items-center justify-between gap-2 cursor-pointer" onclick="toggleTerminal('<%= script.file %>', '<%= safeId %>')">
                <div class="flex flex-col gap-0.5 overflow-hidden">
                    <h3 class="text-white font-medium text-sm md:text-base leading-tight truncate"><%= script.name %></h3>
                    <% if (script.running) { %>
                        <span class="text-green-400 text-[10px] uppercase tracking-wider flex items-center gap-1 font-bold">
                            <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span> Работает
                        </span>
                    <% } else { %>
                        <span class="text-slate-400 text-[10px] uppercase tracking-wider font-bold">Остановлен</span>
                    <% } %>
                </div>
                
                <div class="flex gap-1.5 shrink-0" onclick="event.stopPropagation()">
                    <% if (script.running) { %>
                        <button onclick="stopScript('<%= script.file %>')" class="w-12 h-12 md:w-10 md:h-10 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg flex items-center justify-center transition-colors border border-red-500/20" title="Стоп">
                            <i data-lucide="square" class="w-5 h-5 md:w-4 md:h-4"></i>
                        </button>
                    <% } else { %>
                        <button onclick="startScript('<%= script.file %>')" class="w-12 h-12 md:w-10 md:h-10 bg-blue-600 hover:bg-blue-500 text-white rounded-lg flex items-center justify-center transition-colors" title="Старт">
                            <i data-lucide="play" class="w-5 h-5 md:w-4 md:h-4"></i>
                        </button>
                    <% } %>
                    <button onclick="toggleTerminal('<%= script.file %>', '<%= safeId %>')" class="w-12 h-12 md:w-10 md:h-10 bg-slate-700 hover:bg-slate-600 text-white rounded-lg flex items-center justify-center transition-colors border border-slate-600" title="Терминал">
                        <i data-lucide="chevron-down" id="chevron-<%= safeId %>" class="w-5 h-5 md:w-4 md:h-4 transition-transform duration-300"></i>
                    </button>
                </div>
            </div>
            
            <!-- Terminal Accordion Body -->
            <div id="term-container-<%= safeId %>" class="hidden border-t border-slate-700 bg-[#0c0c0c] flex-col h-[350px]">
                <div class="bg-slate-800 px-3 py-1.5 md:py-2 border-b border-slate-700 flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-500"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                        <span class="text-slate-400 text-xs ml-2 font-mono">Терминал: <%= script.file %></span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="clearLogsUI('<%= safeId %>')" class="text-slate-400 hover:text-white text-xs"><i data-lucide="eraser" class="w-4 h-4"></i></button>
                    </div>
                </div>
                <pre id="terminal-<%= safeId %>" class="flex-1 p-4 overflow-y-auto text-green-400 font-mono text-sm whitespace-pre-wrap">Загрузка...</pre>
            </div>
        </div>
    <% }) %>
</div>

<script>
    let logInterval = null;
    let currentWatchedScript = null;
    const terminal = document.getElementById('terminal');

    async function updateStats() {
        try {
            const res = await fetch('/admin/api/stats');
            const data = await res.json();
            document.getElementById('stat-total').innerText = data.totalReports;
            document.getElementById('stat-published').innerText = data.publishedReports;
            document.getElementById('stat-scheduled').innerText = data.scheduledReports;
            document.getElementById('stat-today').innerText = data.generatedToday;
        } catch(e) {}
    }

    async function pingSitemap(btn) {
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i> <span>Отправка...</span>';
        lucide.createIcons();
        
        try {
            const res = await fetch('/admin/api/sitemap/ping', { method: 'POST' });
            const data = await res.json();
            
            if (data.success) {
                document.getElementById('sitemap-last-ping').innerText = data.date;
                btn.classList.replace('bg-slate-700', 'bg-green-600/20');
                btn.classList.replace('border-slate-600', 'border-green-500/50');
                btn.classList.replace('text-white', 'text-green-400');
                btn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i> <span>Успешно</span>';
            } else {
                alert('Ошибка: ' + (data.error || 'Неизвестная ошибка'));
                btn.innerHTML = originalHtml;
            }
        } catch (e) {
            alert('Ошибка сети при отправке пинга');
            btn.innerHTML = originalHtml;
        }
        
        lucide.createIcons();
        setTimeout(() => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            btn.className = 'mt-2 w-full bg-slate-700 hover:bg-slate-600 border border-slate-600 text-white text-xs font-medium py-1.5 px-3 rounded flex items-center justify-center gap-2 transition-colors';
            lucide.createIcons();
        }, 3000);
    }

    async function startScript(name) {
        if(!confirm('Запустить ' + name + '?')) return;
        const res = await fetch('/admin/api/scripts/start', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({script: name})
        });
        if(res.ok) {
            window.location.reload();
        } else {
            const err = await res.json();
            alert(err.error || 'Ошибка запуска');
        }
    }

    async function stopScript(name) {
        if(!confirm('Остановить ' + name + '? (Это жестко завершит процесс)')) return;
        const res = await fetch('/admin/api/scripts/stop', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({script: name})
        });
        if(res.ok) {
            window.location.reload();
        }
    }

    // Accordion Logic
    const openTerminals = new Set();
    const pollingIntervals = {};

    function toggleTerminal(scriptName, safeId) {
        const container = document.getElementById(`term-container-${safeId}`);
        const chevron = document.getElementById(`chevron-${safeId}`);
        
        if (openTerminals.has(safeId)) {
            // Close
            container.classList.add('hidden');
            container.classList.remove('flex');
            chevron.style.transform = 'rotate(0deg)';
            openTerminals.delete(safeId);
            
            if (pollingIntervals[safeId]) {
                clearInterval(pollingIntervals[safeId]);
                delete pollingIntervals[safeId];
            }
        } else {
            // Open
            container.classList.remove('hidden');
            container.classList.add('flex');
            chevron.style.transform = 'rotate(180deg)';
            openTerminals.add(safeId);
            
            fetchLogsFor(scriptName, safeId);
            pollingIntervals[safeId] = setInterval(() => fetchLogsFor(scriptName, safeId), 1000);
        }
    }

    async function fetchLogsFor(scriptName, safeId) {
        try {
            const res = await fetch(`/admin/api/scripts/logs?script=${scriptName}`);
            const data = await res.json();
            const termNode = document.getElementById(`terminal-${safeId}`);
            if (!termNode) return;
            
            const isScrolledToBottom = termNode.scrollHeight - termNode.clientHeight <= termNode.scrollTop + 10;
            termNode.innerText = data.logs || 'Нет логов...';
            
            if(isScrolledToBottom) {
                termNode.scrollTop = termNode.scrollHeight;
            }
        } catch(e) {
            console.error(e);
        }
    }

    function clearLogsUI(safeId) {
        const termNode = document.getElementById(`terminal-${safeId}`);
        if (termNode) termNode.innerText = '';
    }

    // Инициализация
    updateStats();
    setInterval(updateStats, 15000); 
    
    // Автовыбор первого работающего скрипта для логов
    const runningScripts = <%- JSON.stringify(scripts.filter(s => s.running).map(s => s.file)) %>;
    if(runningScripts.length > 0) {
        const scriptName = runningScripts[0];
        const safeId = scriptName.replace(/\./g, '-');
        toggleTerminal(scriptName, safeId);
    }
</script>

<%- include('admin_layout_footer') %>
