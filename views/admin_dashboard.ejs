<%- include('admin_layout_header', { title: 'Дашборд и Скрипты', page: 'dashboard' }) %>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-sm font-medium">Всего карточек</p>
            <h3 class="text-3xl font-bold text-white mt-1" id="stat-total">-</h3>
        </div>
        <div class="bg-blue-500/20 p-3 rounded-lg"><i data-lucide="database" class="text-blue-400"></i></div>
    </div>
    <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-sm font-medium">Опубликовано</p>
            <h3 class="text-3xl font-bold text-green-400 mt-1" id="stat-published">-</h3>
        </div>
        <div class="bg-green-500/20 p-3 rounded-lg"><i data-lucide="check-circle" class="text-green-400"></i></div>
    </div>
    <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-sm font-medium">В очереди (отложено)</p>
            <h3 class="text-3xl font-bold text-yellow-400 mt-1" id="stat-scheduled">-</h3>
        </div>
        <div class="bg-yellow-500/20 p-3 rounded-lg"><i data-lucide="clock" class="text-yellow-400"></i></div>
    </div>
    <div class="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-slate-400 text-sm font-medium">Сгенерировано сегодня</p>
            <h3 class="text-3xl font-bold text-purple-400 mt-1" id="stat-today">-</h3>
        </div>
        <div class="bg-purple-500/20 p-3 rounded-lg"><i data-lucide="zap" class="text-purple-400"></i></div>
    </div>
</div>

<h2 class="text-xl font-semibold text-white mb-4">Управление скриптами</h2>
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-1 space-y-3">
        <% scripts.forEach(script => { %>
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 hover:border-slate-600 transition-colors shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="terminal-square" class="text-slate-400 w-5 h-5"></i>
                        <h3 class="text-white font-medium text-base"><%= script.name %></h3>
                    </div>
                    <% if (script.running) { %>
                        <span class="bg-green-500/10 text-green-400 border border-green-500/20 text-xs px-2 py-1 rounded-full flex items-center gap-1">
                            <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span> Работает
                        </span>
                    <% } else { %>
                        <span class="bg-slate-700 text-slate-300 border border-slate-600 text-xs px-2 py-1 rounded-full flex items-center gap-1">
                            Остановлен
                        </span>
                    <% } %>
                </div>
                
                <div class="flex gap-2">
                    <button onclick="startScript('<%= script.file %>')" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-1.5 disabled:opacity-50" <%= script.running ? 'disabled' : '' %>>
                        <i data-lucide="play" class="w-4 h-4"></i> Старт
                    </button>
                    <button onclick="stopScript('<%= script.file %>')" class="flex-1 bg-red-600/20 hover:bg-red-600/40 text-red-400 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-1.5 disabled:opacity-50 border border-red-500/20" <%= !script.running ? 'disabled' : '' %>>
                        <i data-lucide="square" class="w-4 h-4"></i> Стоп
                    </button>
                    <button onclick="watchLogs('<%= script.file %>')" class="bg-slate-700 hover:bg-slate-600 text-white px-3 py-1.5 rounded-lg transition-colors border border-slate-600 flex items-center justify-center" title="Смотреть логи">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        <% }) %>
    </div>
    
    <div class="xl:col-span-2">
        <div class="bg-[#0c0c0c] border border-slate-700 rounded-xl overflow-hidden h-[600px] flex flex-col shadow-inner">
            <div class="bg-slate-800 px-4 py-2 border-b border-slate-700 flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-red-500"></span>
                    <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
                    <span class="w-3 h-3 rounded-full bg-green-500"></span>
                    <span class="text-slate-400 text-xs ml-2 font-mono" id="log-title">Терминал</span>
                </div>
                <div class="flex gap-2">
                    <button onclick="clearLogsUI()" class="text-slate-400 hover:text-white text-xs"><i data-lucide="eraser" class="w-4 h-4"></i></button>
                </div>
            </div>
            <pre id="terminal" class="flex-1 p-4 overflow-y-auto text-green-400 font-mono text-sm whitespace-pre-wrap">Выберите скрипт для просмотра логов...</pre>
        </div>
    </div>
</div>

<script>
    let logInterval = null;
    let currentWatchedScript = null;
    const terminal = document.getElementById('terminal');

    async function updateStats() {
        try {
            const res = await fetch('/admin/api/stats');
            const data = await res.json();
            document.getElementById('stat-total').innerText = data.totalReports;
            document.getElementById('stat-published').innerText = data.publishedReports;
            document.getElementById('stat-scheduled').innerText = data.scheduledReports;
            document.getElementById('stat-today').innerText = data.generatedToday;
        } catch(e) {}
    }

    async function startScript(name) {
        if(!confirm('Запустить ' + name + '?')) return;
        const res = await fetch('/admin/api/scripts/start', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({script: name})
        });
        if(res.ok) {
            window.location.reload();
        } else {
            const err = await res.json();
            alert(err.error || 'Ошибка запуска');
        }
    }

    async function stopScript(name) {
        if(!confirm('Остановить ' + name + '? (Это жестко завершит процесс)')) return;
        const res = await fetch('/admin/api/scripts/stop', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({script: name})
        });
        if(res.ok) {
            window.location.reload();
        }
    }

    function watchLogs(name) {
        currentWatchedScript = name;
        document.getElementById('log-title').innerText = `Терминал: ${name}`;
        if(logInterval) clearInterval(logInterval);
        
        fetchLogs();
        logInterval = setInterval(fetchLogs, 1000);
    }

    function clearLogsUI() {
        terminal.innerText = '';
    }

    async function fetchLogs() {
        if(!currentWatchedScript) return;
        try {
            const res = await fetch(`/admin/api/scripts/logs?script=${currentWatchedScript}`);
            const data = await res.json();
            const isScrolledToBottom = terminal.scrollHeight - terminal.clientHeight <= terminal.scrollTop + 10;
            
            terminal.innerText = data.logs || 'Нет логов...';
            
            if(isScrolledToBottom) {
                terminal.scrollTop = terminal.scrollHeight;
            }
        } catch(e) {
            console.error(e);
        }
    }

    // Инициализация
    updateStats();
    setInterval(updateStats, 15000); // Обновляем стату раз в 15 секунд
    
    // Автовыбор первого работающего скрипта для логов
    const runningScripts = <%- JSON.stringify(scripts.filter(s => s.running).map(s => s.file)) %>;
    if(runningScripts.length > 0) {
        watchLogs(runningScripts[0]);
    }
</script>

<%- include('admin_layout_footer') %>
