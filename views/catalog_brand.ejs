<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seoTitle || `Коды ошибок ${brandName} - расшифровка и причины` %></title>
  <meta name="description" content="<%= seoDescription || `Полная база кодов неисправностей OBD2 для автомобилей ${brandName}. Узнайте причины ошибок чек енджин и варианты ремонта.` %>">
  <link rel="canonical" href="https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = { 
      darkMode: 'class', 
      theme: { extend: { colors: { brand: '#0077FF', surface: '#F5F5F7' } } } 
    }
  </script>
  <link rel="stylesheet" href="/style.css?v=2">
  <script src="/main.js?v=2" defer></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Schema.org JSON-LD Breadcrumbs -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://7set.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Каталог марок",
        "item": "https://7set.pro/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= brandName %>",
        "item": "https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>"
      }
    ]
  }
  </script>
</head>
<body class="bg-surface dark:bg-slate-900 text-gray-900 dark:text-white font-sans antialiased min-h-screen flex flex-col justify-between">
  <div class="max-w-5xl mx-auto p-4 md:p-6 w-full flex-grow">
    <!-- Шапка (Header) -->
    <%- include('partials/header') %>

    <main class="space-y-8">
      <!-- Хлебные крошки -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400 overflow-x-auto whitespace-nowrap pb-2">
          <li>
            <a href="/" class="hover:text-brand flex items-center transition-colors">
              <i data-lucide="home" class="w-4 h-4 mr-1"></i> Главная
            </a>
          </li>
          <li class="flex items-center space-x-2">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <a href="/catalog" class="hover:text-brand transition-colors">Каталог</a>
          </li>
          <li class="flex items-center space-x-2" aria-current="page">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <span class="font-semibold text-gray-900 dark:text-white capitalize"><%= brandName %></span>
          </li>
        </ol>
      </nav>

      <!-- Контент Марки -->
      <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-10 shadow-sm border border-gray-100 dark:border-slate-700">
        <div class="flex flex-col items-center mb-8">
            <% if(logoSlug) { %>
              <img src="/img/logos/<%= logoSlug %>-logo-60x60-px.webp" alt="Логотип <%= brandName %>" width="80" height="80" class="object-contain mb-4 drop-shadow-md">
            <% } %>
            <h1 class="text-3xl md:text-4xl font-black text-center text-gray-900 dark:text-white capitalize">
              Коды ошибок <%= brandName %>
            </h1>
            <p class="mt-3 text-gray-500 dark:text-gray-400 text-center max-w-2xl">
              Выберите модель <%= brandName %> для просмотра детальной расшифровки кодов неисправностей.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <% models.forEach(function(item) { %>
            <a href="/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>/<%= encodeURIComponent(item.model.toLowerCase()) %>" class="bg-gradient-to-b from-[#ffffff] to-slate-50 dark:from-slate-700/50 dark:to-slate-800/50 backdrop-blur-md p-5 rounded-2xl border border-slate-200 dark:border-slate-600/80 shadow-sm hover:shadow-[0_8px_20px_-6px_rgba(0,119,255,0.25)] dark:hover:shadow-[0_8px_20px_-6px_rgba(0,119,255,0.4)] hover:border-brand/50 dark:hover:border-brand/50 transition-all group flex flex-col items-center text-center duration-300 hover:-translate-y-1.5">
              <h2 class="font-bold text-lg text-gray-900 dark:text-white capitalize group-hover:text-brand transition-colors mb-2"><%= item.model %></h2>
              <span class="text-xs font-semibold text-brand bg-brand/10 px-2.5 py-1 rounded-full"><%= item._count.model %> ошибок</span>
            </a>
          <% }); %>
          <% if(models.length === 0) { %>
            <p class="col-span-full text-center text-gray-500">Для этой марки пока нет разобранных моделей.</p>
          <% } %>
        </div>
      </section>
    </main>

  </div>

  <!-- Подвал (Footer) -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
    <%- include('partials/footer') %>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>
