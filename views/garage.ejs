<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Мой Гараж и Тарифы — 7Set.Pro</title>
  <link rel="canonical" href="https://7set.pro/garage" />
  
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    }
    tailwind.config = { darkMode: 'class', theme: { extend: { colors: { brand: '#0077FF', surface: '#F5F5F7' } } } }
  </script>     
  <link rel="preload" href="/tailwind.css" as="style">
  <link rel="stylesheet" href="/tailwind.css">

  <script src="/main.js" defer></script>
  <script src="https://unpkg.com/lucide@1.32.0/dist/umd/lucide.min.js" defer></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YYG95EJDXR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-YYG95EJDXR');
    </script>
</head>
<body class="bg-surface dark:bg-slate-900 text-gray-900 dark:text-white font-sans antialiased min-h-screen flex flex-col justify-between">
  <div class="max-w-5xl mx-auto p-4 md:p-6 w-full flex-grow">
    <!-- Шапка -->
    <%- include('partials/header') %>

    <!-- Секция Тарифов -->
    <div class="pricing-section bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 dark:border-slate-700 mb-8 mt-6">
      <div class="text-center max-w-lg mx-auto mb-6">
        <h2 class="text-2xl md:text-3xl font-bold mb-2 dark:text-white">Выберите тариф для Гаража</h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Подписка дает доступ к мгновенному ИИ-подбору заправочных объемов, допусков масел и размеров запчастей.</p>
      </div>
      <div class="tariffs grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="border border-gray-200 dark:border-slate-700 rounded-2xl p-5 text-center flex flex-col justify-between hover:border-brand/40 dark:hover:border-brand/40 transition-colors">
          <div>
            <h3 class="font-bold text-lg mb-1 dark:text-white">1 Авто</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Для личного пользования</p>
            <div class="text-2xl font-black text-brand mb-4">$5.99 <span class="text-xs font-normal text-gray-500 dark:text-gray-400">/ мес</span></div>
          </div>
          <button type="button" onclick="selectPlan('single')" class="w-full bg-gray-100 dark:bg-slate-700/50 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-900 dark:text-white font-semibold py-2.5 rounded-xl text-sm transition-colors">Выбрать базовый</button>
        </div>

        <div class="border-2 border-brand rounded-2xl p-5 text-center flex flex-col justify-between relative shadow-md bg-blue-50/20 dark:bg-brand/5">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand text-white text-[10px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider">Популярный</div>
          <div>
            <h3 class="font-bold text-lg mb-1 dark:text-white">До 5 Авто</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Для семьи и автолюбителей</p>
            <div class="text-2xl font-black text-brand mb-4">$15.99 <span class="text-xs font-normal text-gray-500 dark:text-gray-400">/ мес</span></div>
          </div>
          <button type="button" onclick="selectPlan('multi')" class="w-full bg-brand hover:bg-blue-600 text-white font-semibold py-2.5 rounded-xl text-sm transition-colors shadow-sm">Подключить семью</button>
        </div>

        <div class="border border-gray-200 dark:border-slate-700 rounded-2xl p-5 text-center flex flex-col justify-between hover:border-brand/40 transition-colors">
          <div>
            <h3 class="font-bold text-lg mb-1 dark:text-white">Безлимит</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Для автоподбора и СТО</p>
            <div class="text-2xl font-black text-brand mb-4">$25.99 <span class="text-xs font-normal text-gray-500 dark:text-gray-400">/ мес</span></div>
          </div>
          <button type="button" onclick="selectPlan('pro')" class="w-full bg-gray-900 dark:bg-slate-700 hover:bg-gray-800 dark:hover:bg-slate-600 text-white font-semibold py-2.5 rounded-xl text-sm transition-colors">Тариф для профи</button>
        </div>
      </div>
    </div>

    <!-- Форма Добавления Авто -->
    <div class="garage-add-car bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 dark:border-slate-700 mb-8">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2 dark:text-white">
        <i data-lucide="plus-circle" class="text-brand"></i>
        Добавить автомобиль в Гараж
      </h2>
      <form id="add-car-form" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
        <input type="text" id="car-brand" placeholder="Марка (напр. Toyota)" class="bg-gray-50 dark:bg-slate-900/40 border border-gray-200 dark:border-slate-600 rounded-xl px-3.5 py-3 text-sm dark:text-white focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-brand/20 focus:border-brand outline-none" required>
        <input type="text" id="car-model" placeholder="Модель (напр. Camry)" class="bg-gray-50 dark:bg-slate-900/40 border border-gray-200 dark:border-slate-600 rounded-xl px-3.5 py-3 text-sm dark:text-white focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-brand/20 focus:border-brand outline-none" required>
        <input type="text" id="car-engine" placeholder="Двигатель (напр. 2.5 2AR-FE)" class="bg-gray-50 dark:bg-slate-900/40 border border-gray-200 dark:border-slate-600 rounded-xl px-3.5 py-3 text-sm dark:text-white focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-brand/20 focus:border-brand outline-none" required>
        <input type="number" id="car-year" placeholder="Год (напр. 2018)" class="bg-gray-50 dark:bg-slate-900/40 border border-gray-200 dark:border-slate-600 rounded-xl px-3.5 py-3 text-sm dark:text-white focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-brand/20 focus:border-brand outline-none" required>
        <div class="sm:col-span-2 md:col-span-4 mt-2">
          <button type="submit" class="w-full bg-brand text-white font-semibold rounded-xl py-3.5 hover:bg-blue-600 transition-colors shadow-sm flex justify-center items-center gap-2">
            <i data-lucide="sparkles" class="w-4 h-4"></i> Подобрать ТО через ИИ
          </button>
        </div>
      </form>
      <div id="consumables-result" class="result-card d-none"></div>
    </div>

    <!-- Список Автомобилей в Гараже -->
    <div class="saved-cars-section mb-12">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2 dark:text-white">
        <i data-lucide="car" class="text-brand"></i>
        Сохранённый автопарк (<%= cars.length %>)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% if (cars.length > 0) { %>
          <% cars.forEach(car => { 
            let cons = {};
            try { cons = typeof car.consumablesJson === 'string' ? JSON.parse(car.consumablesJson) : car.consumablesJson; } catch(e){}
          %>
            <div class="bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow relative">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="font-bold text-lg text-gray-900 dark:text-white"><%= car.brand %> <%= car.model %></h3>
                  <p class="text-xs text-gray-500 dark:text-gray-400"><%= car.engine %> • <%= car.year %> г.в.</p>
                </div>
                <button onclick="deleteCarFromGarage('<%= car.id %>')" class="text-red-400 hover:text-red-500 dark:hover:text-red-400 p-1 rounded-lg transition-colors" title="Удалить авто">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
              <div class="space-y-1.5 text-xs text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-slate-900/40 p-3.5 rounded-xl border border-gray-100 dark:border-slate-700">
                <div><b>💧 Масло:</b> <%= cons.oil?.type || 'N/A' %> (<%= cons.oil?.spec || 'N/A' %>, <%= cons.oil?.volume_liters || 0 %> л)</div>
                <div><b>🧹 Дворники:</b> Водитель <%= cons.wipers?.driver_mm || 0 %> мм / Пассажир <%= cons.wipers?.passenger_mm || 0 %> мм</div>
                <div><b>⛽ Топливо:</b> <%= cons.fuel?.type || 'N/A' %></div>
                <div><b>❄️ Антифриз:</b> <%= cons.coolant?.type || 'N/A' %> (<%= cons.coolant?.color || '' %>)</div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-gray-500 dark:text-gray-400 text-sm italic col-span-full text-center py-8">В вашем гараже пока нет автомобилей. Добавьте первую машину выше!</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
    <%- include('partials/footer') %>
  </div>
</body>
</html>
