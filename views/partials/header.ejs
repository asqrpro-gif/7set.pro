    <header class="flex justify-between items-center mb-6 bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700">
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <img src="/img/logo_7set_pro_180x26_px.webp" alt="7Set.Pro" width="180" height="26" class="w-[180px] h-[26px] object-contain order-1 shrink-0">
        <span class="font-normal text-sm text-gray-500 dark:text-gray-400 ml-1 hidden md:inline order-2">| Умная автодиагностика</span>
      </a>
      <!-- Desktop Navigation Menu (hidden on mobile, replaced by bottom nav) -->
      <div class="hidden md:block">
        <button id="desktop-menu-toggle" class="p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-slate-700 transition-all flex items-center justify-center hover:scale-105 active:scale-95" aria-label="Открыть меню">
          <i data-lucide="menu" class="w-6 h-6 text-gray-700 dark:text-gray-300"></i>
        </button>
      </div>
    </header>

    <!-- Side Drawer & Overlay -->
    <div id="drawer-overlay" class="fixed inset-0 bg-slate-900/30 backdrop-blur-[2px] z-[100] opacity-0 invisible transition-all duration-300 hidden md:block"></div>
    
    <div id="desktop-drawer" class="fixed top-0 right-0 h-full w-[280px] bg-white dark:bg-slate-800 shadow-2xl z-[101] transform translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] hidden md:flex flex-col border-l border-gray-100 dark:border-slate-700">
      <!-- Drawer Header -->
      <div class="p-5 flex justify-between items-center border-b border-gray-100 dark:border-slate-700 shrink-0">
        <span class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2">
          <i data-lucide="compass" class="w-4 h-4 text-brand"></i> Навигация
        </span>
        <button id="close-drawer-btn" class="p-2 rounded-xl hover:bg-gray-100 dark:hover:bg-slate-700 text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 transition-colors">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Drawer Content -->
      <div class="p-3 flex-1 overflow-y-auto flex flex-col gap-1">
        <a href="/" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-brand hover:text-white transition-colors">
          <i data-lucide="activity" class="w-4 h-4 text-gray-400 group-hover:text-white transition-colors"></i>
          <span>Диагноз</span>
        </a>
        
        <a href="/catalog" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-brand hover:text-white transition-colors">
          <i data-lucide="book-open" class="w-4 h-4 text-gray-400 group-hover:text-white transition-colors"></i>
          <span>Каталог</span>
        </a>
        
        <a href="/garage" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-brand hover:text-white transition-colors">
          <i data-lucide="car" class="w-4 h-4 text-gray-400 group-hover:text-white transition-colors"></i>
          <span>Гараж и ТО</span>
        </a>
        
        <a href="/profile" class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-brand hover:text-white transition-colors">
          <i data-lucide="user" class="w-4 h-4 text-gray-400 group-hover:text-white transition-colors"></i>
          <span>Профиль</span>
        </a>
      </div>

      <!-- Drawer Footer -->
      <div class="p-3 border-t border-gray-100 dark:border-slate-700 shrink-0">
        <button id="desktop-theme-toggle" class="w-full group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
          <i data-lucide="moon" class="w-4 h-4 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-200 transition-colors" id="desktop-theme-icon"></i>
          <span id="desktop-theme-text">Тёмная тема</span>
        </button>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const menuToggle = document.getElementById('desktop-menu-toggle');
        const drawer = document.getElementById('desktop-drawer');
        const overlay = document.getElementById('drawer-overlay');
        const closeBtn = document.getElementById('close-drawer-btn');
        
        const themeToggle = document.getElementById('desktop-theme-toggle');
        const themeIcon = document.getElementById('desktop-theme-icon');
        const themeText = document.getElementById('desktop-theme-text');

        // Открытие и закрытие Drawer
        const openDrawer = () => {
          overlay.classList.remove('opacity-0', 'invisible');
          overlay.classList.add('opacity-100', 'visible');
          drawer.classList.remove('translate-x-full');
          drawer.classList.add('translate-x-0');
          // Блокируем скролл основной страницы
          document.body.style.overflow = 'hidden';
        };

        const closeDrawer = () => {
          overlay.classList.remove('opacity-100', 'visible');
          overlay.classList.add('opacity-0', 'invisible');
          drawer.classList.remove('translate-x-0');
          drawer.classList.add('translate-x-full');
          // Возвращаем скролл
          document.body.style.overflow = '';
        };

        if (menuToggle && drawer && overlay && closeBtn) {
          menuToggle.addEventListener('click', openDrawer);
          closeBtn.addEventListener('click', closeDrawer);
          overlay.addEventListener('click', closeDrawer);
        }

        // Логика смены темы
        if (themeToggle) {
          const updateThemeUI = () => {
            const isDark = document.documentElement.classList.contains('dark');
            themeIcon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
            themeText.textContent = isDark ? 'Светлая тема' : 'Тёмная тема';
            lucide.createIcons();
          };

          updateThemeUI();

          themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeUI();
            
            // Синхронизируем мобильную кнопку, если она есть
            const mobileIcon = document.getElementById('mobile-theme-icon');
            if (mobileIcon) {
              mobileIcon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
              lucide.createIcons();
            }
          });
        }
      });
    </script>
