<!-- Сквозная кнопка "Наверх" -->
<button id="scrollToTopBtn" aria-label="Вернуться наверх" class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-[100] p-3.5 rounded-2xl bg-[#0077FF] text-white shadow-[0_4px_15px_rgba(0,119,255,0.4)] border border-blue-400/50 transition-all duration-300 transform translate-y-16 opacity-0 pointer-events-none hover:bg-blue-600 hover:shadow-[0_6px_20px_rgba(0,119,255,0.6)] hover:-translate-y-1 active:scale-95 flex items-center justify-center">
  <i data-lucide="arrow-up" class="w-6 h-6"></i>
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollBtn = document.getElementById('scrollToTopBtn');
    
    if (scrollBtn) {
      // Показываем кнопку после прокрутки на 400px
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          scrollBtn.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
          scrollBtn.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          scrollBtn.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
          scrollBtn.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        }
      });

      // Плавная прокрутка наверх при клике
      scrollBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  });
</script>
