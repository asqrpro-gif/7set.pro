<!DOCTYPE html>
<html lang="ru">

<head>
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    }
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= seoTitle %>
  </title>
  <meta name="description" content="<%= seoDescription %>">
  <link rel="canonical" href="<%= pageUrl %>">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDescription %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:type" content="article">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <%- schemaHtml %>
    
    

    <link rel="preload" href="/tailwind.css" as="style">
  <link rel="stylesheet" href="/tailwind.css">

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="/main.js?v=2" defer></script>
    <script src="https://unpkg.com/lucide@1.32.0/dist/umd/lucide.min.js" defer></script>
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments) };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
          k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a)
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=111154643', 'ym');

      ym(111154643, 'init', { ssr: true, webvisor: true, clickmap: true, ecommerce: "dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
    </script>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/111154643" class="yandex-pixel" alt="" /></div>
    </noscript>
    <!-- /Yandex.Metrika counter -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YYG95EJDXR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-YYG95EJDXR');
    </script>
</head>

<body class="bg-surface dark:bg-slate-900 text-gray-900 dark:text-white font-sans antialiased min-h-screen flex flex-col justify-between pb-20 md:pb-0">
  <div class="max-w-5xl mx-auto p-4 md:p-6 w-full flex-grow">
    <!-- Шапка (Header) -->
    <%- include('partials/header') %>

    <nav class="flex text-gray-500 text-[11px] md:text-xs mb-6 px-1" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-2">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-brand inline-flex items-center transition-colors">Главная</a>
        </li>
        <li>
          <div class="flex items-center">
            <i data-lucide="chevron-right" class="w-3 h-3 mx-1 text-gray-400"></i>
            <a href="/catalog" class="hover:text-brand transition-colors">Архив</a>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <i data-lucide="chevron-right" class="w-3 h-3 mx-1 text-gray-400"></i>
            <a href="/catalog/<%= encodeURIComponent(brand.toLowerCase()) %>" class="hover:text-brand transition-colors">
              <%= displayBrand %>
            </a>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <i data-lucide="chevron-right" class="w-3 h-3 mx-1 text-gray-400"></i>
            <a href="/catalog/<%= encodeURIComponent(brand.toLowerCase()) %>/<%= encodeURIComponent(model.toLowerCase()) %>"
              class="hover:text-brand transition-colors">
              <%= displayModel %>
            </a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <i data-lucide="chevron-right" class="w-3 h-3 mx-1 text-gray-400"></i>
            <span class="font-semibold text-gray-800 dark:text-gray-200">
              <%= isUnsupportedReport ? 'Неизвестный код' : displayCode %>
            </span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="<%= !isUnlockedForUser ? 'diagnostic-grid md:items-stretch' : 'flex flex-col gap-6 mt-4' %>">
      <article
        class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm p-5 border border-transparent dark:border-slate-700 <%= !isUnlockedForUser ? 'h-full flex flex-col' : '' %>">
        <div class="flex justify-between items-start mb-4">
          <div class="flex flex-wrap gap-2">
            <span class="<%= severityClass %> text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide">
              <%= severityText %>
            </span>
            <span class="<%= drivabilityDataClass %>"><%- drivabilityData.text %></span>
          </div>
          <span class="text-xs text-gray-400 dark:text-gray-500 font-mono font-medium mt-1">Код: <%= isUnsupportedReport
              ? 'Незарегистрированный' : displayCode %></span>
        </div>

        <h1 class="text-2xl font-bold mb-3 text-gray-900 dark:text-white">
          <%= seoTitle %>
        </h1>
        <div
          class="flex flex-col items-center justify-center bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 shadow-sm rounded-2xl p-8 mb-6">
          <% 
            const brandMap = {
              'toyota': 'toyota',
              'hyundai': 'hyundai',
              'kia': 'kia',
              'lada': 'lada',
              'volkswagen': 'vw',
              'vw': 'vw',
              'skoda': 'skoda',
              'renault': 'renault',
              'nissan': 'nissan',
              'chevrolet': 'chevrolet',
              'ford': 'ford',
              'bmw': 'bmw',
              'mercedes-benz': 'mercedes-benz',
              'mercedes': 'mercedes-benz',
              'audi': 'audi',
              'mazda': 'mazda',
              'geely': 'geely',
              'chery': 'chery',
              'mitsubishi': 'mitsubishi',
              'honda': 'honda',
              'lexus': 'lexus',
              'haval': 'haval',
              'subaru': 'subaru',
              'suzuki': 'suzuki',
              'opel': 'opel',
              'daewoo': 'daowoo',
              'peugeot': 'peugeot',
              'uaz': 'uaz',
              'gaz': 'gaz',
              'changan': 'changan',
              'exeed': 'exeed',
              'tank': 'tank'
            };
            const currentBrandLower = brand ? brand.toLowerCase() : '';
            const logoSlug = brandMap[currentBrandLower];
          %>
          <% if (logoSlug) { %>
            <img src="/img/logos/<%= logoSlug %>-logo-60x60-px.webp" fetchpriority="high" width="60" height="60" alt="<%= isUnsupportedReport ? 'Диагностика и проверка неизвестного или ложного кода ошибки автомобиля' : `Детальная расшифровка и ремонт ошибки ${displayCode} для ${displayBrand} ${displayModel}` %>" class="order-1 shrink-0" />
            <span class="text-gray-800 dark:text-gray-200 font-semibold text-lg mt-4 order-2"><%= displayBrand %> <%= displayModel %></span>
          <% } else { %>
            <i data-lucide="car-front" class="w-16 h-16 text-brand order-1 shrink-0" aria-hidden="true"></i>
            <span class="text-gray-800 dark:text-gray-200 font-semibold text-lg mt-4 order-2"><%= displayBrand %> <%= displayModel %></span>
            <img src="https://placehold.co/600x400/ffffff/0077FF?text=<%= isUnsupportedReport ? 'UNKNOWN' : displayCode %>" width="600" height="400" alt="<%= isUnsupportedReport ? 'Диагностика и проверка неизвестного или ложного кода ошибки автомобиля' : `Детальная расшифровка и ремонт ошибки ${displayCode} для ${displayBrand} ${displayModel}` %>" class="sr-only order-3" />
          <% } %>
        </div>
        <p class="text-gray-500 dark:text-gray-400 font-medium text-sm leading-relaxed mb-4"><%- summaryText %></p>
        <div class="h-px bg-gray-100 dark:bg-slate-700 w-full mb-4"></div>
        <p class="text-gray-800 dark:text-gray-200 leading-relaxed"><%- teaserText %></p>
      </article>

      <div id="paywall-container" data-report-id="<%= reportId %>" class="<%= !isUnlockedForUser ? 'h-full' : '' %>">
        <div class="report-content relative <%= !isUnlockedForUser ? 'h-full flex flex-col justify-center items-center bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-transparent dark:border-slate-700 overflow-hidden' : '' %>">
          <div class="<%= !isUnlockedForUser ? 'paywall-blur-container !absolute inset-0 overflow-hidden opacity-90 p-4 md:p-6' : '' %>">

            <details class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700" open>
              <summary class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2 class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="file-search" class="w-5 h-5 text-brand shrink-0 order-1"></i> <span class="order-2">Полный разбор причины</span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800 prose prose-blue prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200">
                <%- fullAnalysisHtml %>
              </div>
            </details>

            <% if (typeof diagnosticDataHtml !== 'undefined' && diagnosticDataHtml) { %>
            <details class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700" open>
              <summary class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2 class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="cpu" class="w-5 h-5 text-indigo-500 shrink-0 order-1"></i> <span class="order-2">Спецификации для диагноста</span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 prose prose-blue prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200 font-mono text-sm">
                <%- diagnosticDataHtml %>
              </div>
            </details>
            <% } %>

            <% if (typeof proTipsHtml !== 'undefined' && proTipsHtml) { %>
            <details class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700" open>
              <summary class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2 class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="lightbulb" class="w-5 h-5 text-yellow-500 shrink-0 order-1"></i> <span class="order-2">Советы эксперта по <%= displayBrand %></span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800 prose prose-blue prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200">
                <%- proTipsHtml %>
              </div>
            </details>
            <% } %>

            <% if (typeof drivingRisksHtml !== 'undefined' && drivingRisksHtml) { %>
            <details class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700" open>
              <summary class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2 class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="alert-triangle" class="w-5 h-5 text-red-500 shrink-0 order-1"></i> <span class="order-2">ПДД и последствия эксплуатации</span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800 prose prose-blue prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200">
                <%- drivingRisksHtml %>
              </div>
            </details>
            <% } %>

            <details class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700" open>
              <summary class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2 class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="shield-alert" class="w-5 h-5 text-red-500 shrink-0 order-1"></i> <span class="order-2">Защита от обмана на СТО</span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800 prose prose-blue prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200">
                <%- scamProtectionHtml %>
              </div>
            </details>
            <details
              class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700"
              open>
              <summary
                class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2
                  class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="wallet" class="w-5 h-5 text-green-600 shrink-0 order-1"></i> <span class="order-2">Финансовый прогноз</span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800">
                <div class="grid grid-cols-2 gap-4 mt-2">
                  <div class="premium-glow-card">
                    <div class="relative z-10">
                      <h3 class="text-xs text-gray-500 dark:text-gray-400 mb-1 flex items-center gap-1"><i
                          data-lucide="settings" class="w-3 h-3"></i> Запчасти</h3>
                      <div class="font-bold text-lg text-gray-800 dark:text-gray-100"><span
                          class="text-gray-400 font-normal mr-1">~</span><%- pricePartsHtml %></div>
                    </div>
                  </div>
                  <div class="premium-glow-card">
                    <div class="relative z-10">
                      <h3 class="text-xs text-gray-500 dark:text-gray-400 mb-1 flex items-center gap-1"><i
                          data-lucide="user-cog" class="w-3 h-3"></i> Работа СТО</h3>
                      <div class="font-bold text-lg text-gray-800 dark:text-gray-100"><span
                          class="text-gray-400 font-normal mr-1">~</span><%- priceLaborHtml %></div>
                    </div>
                  </div>
                </div>
                <div
                  class="mt-4 p-3 bg-gray-50 dark:bg-slate-700/30 rounded-xl border border-dashed border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 flex gap-2 items-start leading-relaxed">
                  <i data-lucide="banknote" class="w-4 h-4 flex-shrink-0 mt-0.5 text-gray-400"></i>
                  <span>Указанные цены сгенерированы на основе общих рыночных данных. Они являются ориентировочными,
                    чтобы вы понимали примерный масштаб проблемы. Точную стоимость запчастей и работ может назвать
                    только мастер на СТО после физической диагностики.</span>
                </div>
                <% if (typeof oemPartsTableHtml !== 'undefined' && oemPartsTableHtml) { %>
                  <div class="mt-6 prose prose-blue prose-sm dark:prose-invert max-w-none text-gray-800 dark:text-gray-200">
                    <h3 class="flex items-center gap-2 text-base font-bold text-gray-900 dark:text-white mb-3"><i data-lucide='settings' class='w-5 h-5 text-gray-500 shrink-0 order-1'></i> <span class="order-2">Возможные запчасти (OEM / Аналоги)</span></h3>
                    <%- oemPartsTableHtml %>
                  </div>
                <% } %>
              </div>
            </details>

            <details
              class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700"
              open>
              <summary
                class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2
                  class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="wrench" class="w-5 h-5 text-gray-500 dark:text-gray-400 shrink-0 order-1"></i> <span class="order-2">Сделай сам</span>
                  <span
                    class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-gray-300 ml-auto font-normal shrink-0 order-3">
                    <%= report.diy_difficulty_text || 'Неизвестно' %>
                  </span></h2>
              </summary>
              <div class="p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800">
                <div class="grid grid-cols-2 gap-3 mb-5">
                  <div class="premium-glow-card h-full" style="padding: 14px;">
                    <div class="relative z-10 text-center flex flex-col justify-center h-full">
                      <span
                        class="text-xs text-gray-500 dark:text-gray-400 font-medium uppercase tracking-wider mb-1">Сложность</span>
                      <strong class="text-sm md:text-base font-bold text-gray-800 dark:text-gray-100">
                        <%= difficultyScoreHtml %>
                      </strong>
                    </div>
                  </div>
                  <div class="premium-glow-card h-full" style="padding: 14px;">
                    <div class="relative z-10 text-center flex flex-col justify-center h-full">
                      <span
                        class="text-xs text-gray-500 dark:text-gray-400 font-medium uppercase tracking-wider mb-1">Время</span>
                      <strong class="text-sm md:text-base font-bold text-gray-800 dark:text-gray-100">
                        <%= report.diy_time || 'Не указано' %>
                      </strong>
                    </div>
                  </div>
                  <div class="col-span-2 premium-glow-card" style="padding: 14px;">
                    <div class="relative z-10 text-left flex flex-col">
                      <span
                        class="text-xs text-gray-500 dark:text-gray-400 font-medium uppercase tracking-wider mb-1">Необходимые инструменты</span>
                      <div class="text-sm md:text-base font-medium text-gray-800 dark:text-gray-100 leading-relaxed <%= (typeof toolsTableHtml !== 'undefined' && toolsTableHtml) ? 'prose prose-sm dark:prose-invert max-w-none' : '' %>">
                        <% if (typeof toolsTableHtml !== 'undefined' && toolsTableHtml) { %>
                          <%- toolsTableHtml %>
                        <% } else { %>
                          <%= report.diy_tools || 'Не указано' %>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="bg-orange-50 dark:bg-orange-900/20 border-l-4 border-orange-500 p-4 mb-4 rounded-r-xl">
                  <strong class="text-orange-600 dark:text-orange-400 flex items-center gap-2 mb-2 text-sm">
                    <i data-lucide="alert-triangle" class="w-4 h-4"></i> Внимание!
                  </strong>
                  <p class="text-orange-900 dark:text-orange-200 text-sm md:text-base m-0 leading-relaxed">
                    Автомобиль — это механизм повышенной опасности. Любое неквалифицированное вмешательство может
                    привести к серьезным поломкам (вплоть до "окирпичивания" электронных блоков) или создать угрозу ДТП.
                    Данная инструкция носит исключительно ознакомительный характер и не является прямым руководством к
                    действию. Всю ответственность за последствия самостоятельного ремонта вы берете на себя.
                  </p>
                </div>
                <div
                  class="prose prose-blue prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200 mt-4">
                  <%- diyInstructionsHtml %></div>
              </div>
            </details>
            
            <% if (typeof seoFooterHtml !== 'undefined' && seoFooterHtml) { %>
            <details
              class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm mb-4 overflow-hidden border border-gray-50 dark:border-slate-700"
              open>
              <summary
                class="flex items-center gap-3 font-semibold p-5 cursor-pointer hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors list-none outline-none">
                <h2
                  class="text-base md:text-lg font-semibold m-0 flex items-center gap-3 w-full font-inherit text-inherit text-gray-900 dark:text-white">
                  <i data-lucide="link" class="w-5 h-5 text-blue-500 shrink-0 order-1"></i> <span class="order-2">Полезные ссылки</span></h2>
              </summary>
              <div
                class="seo-footer-content p-5 border-t border-gray-50 dark:border-slate-700 bg-white dark:bg-slate-800 prose prose-sm md:prose-lg dark:prose-invert max-w-none text-gray-800 dark:text-gray-200">
                <%- seoFooterHtml %>
              </div>
            </details>
            <% } %>
            
            <!-- Блок вовлечения (RLHF и Шаринг) -->
            <% if (report && report.is_complete !== false) { %>
            <div class="engagement-block mt-8 mb-4 bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-5 md:p-6 transition-all duration-300">
              <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex-1 w-full">
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3" id="feedback-title">Помог ли вам этот разбор ошибки?</h3>
                  <div id="feedback-buttons" class="flex gap-3">
                    <button class="feedback-btn flex items-center justify-center gap-2 bg-gray-50 hover:bg-green-50 dark:bg-slate-700/50 dark:hover:bg-green-900/20 text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 border border-gray-200 dark:border-slate-600 rounded-xl px-4 py-2 font-medium transition-colors flex-1 md:flex-none" data-type="like" data-id="<%= report.id %>">
                      <i data-lucide="thumbs-up" class="w-5 h-5"></i> Да
                    </button>
                    <button class="feedback-btn flex items-center justify-center gap-2 bg-gray-50 hover:bg-red-50 dark:bg-slate-700/50 dark:hover:bg-red-900/20 text-gray-700 dark:text-gray-300 hover:text-red-600 dark:hover:text-red-400 border border-gray-200 dark:border-slate-600 rounded-xl px-4 py-2 font-medium transition-colors flex-1 md:flex-none" data-type="dislike" data-id="<%= report.id %>">
                      <i data-lucide="thumbs-down" class="w-5 h-5"></i> Нет
                    </button>
                  </div>
                  <div id="feedback-form" class="hidden mt-3 w-full">
                    <textarea id="feedback-comment" class="w-full bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-600 rounded-xl p-3 text-sm text-gray-800 dark:text-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent outline-none resize-none transition-all" rows="2" placeholder="Чего не хватило в отчете?"></textarea>
                    <div class="flex justify-end mt-2">
                      <button id="feedback-submit" class="bg-brand hover:bg-blue-600 text-white font-medium rounded-lg px-4 py-1.5 text-sm transition-colors shadow-sm" data-id="<%= report.id %>">Отправить</button>
                    </div>
                  </div>
                  <div id="feedback-success" class="hidden mt-2 text-green-600 dark:text-green-400 font-medium flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-5 h-5"></i> Спасибо за оценку!
                  </div>
                </div>
                
                <div class="hidden md:block w-px h-24 bg-gray-200 dark:bg-slate-700"></div>
                <hr class="md:hidden w-full border-gray-200 dark:border-slate-700 my-2">

                <div class="flex-1 w-full">
                  <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 font-medium">Сохраните инструкцию, чтобы не потерять, или отправьте вашему механику:</p>
                  <div class="flex flex-wrap gap-2">
                    <% const shareUrl = `https://7set.pro/catalog/${encodeURIComponent(displayBrand.toLowerCase())}/${encodeURIComponent(displayModel.toLowerCase())}/${encodeURIComponent(report.code.toLowerCase())}`; %>
                    <% const shareTitle = `Ошибка ${report.code.toUpperCase()} на ${displayBrand} ${displayModel} - Причины и ремонт`; %>
                    
                    <a href="https://t.me/share/url?url=<%= encodeURIComponent(shareUrl) %>&text=<%= encodeURIComponent(shareTitle) %>" target="_blank" rel="noopener noreferrer" class="share-action-btn flex items-center justify-center bg-[#0088cc] hover:bg-[#0077b3] text-white rounded-xl p-2.5 transition-colors shadow-sm flex-1 md:flex-none" title="Telegram" data-type="share_tg" data-id="<%= report.id %>">
                      <i data-lucide="send" class="w-5 h-5"></i>
                    </a>
                    
                    <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(shareTitle + ' ' + shareUrl) %>" target="_blank" rel="noopener noreferrer" class="share-action-btn flex items-center justify-center bg-[#25D366] hover:bg-[#128C7E] text-white rounded-xl p-2.5 transition-colors shadow-sm flex-1 md:flex-none" title="WhatsApp" data-type="share_wa" data-id="<%= report.id %>">
                      <i data-lucide="message-circle" class="w-5 h-5"></i>
                    </a>
                    
                    <button class="share-copy-btn share-action-btn flex items-center justify-center gap-2 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-200 border border-transparent dark:border-slate-600 rounded-xl px-4 py-2.5 font-medium transition-colors shadow-sm flex-auto md:flex-1" data-url="<%= shareUrl %>" data-type="share_link" data-id="<%= report.id %>">
                      <i data-lucide="link" class="w-5 h-5"></i> <span class="share-copy-text">Скопировать</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <% } %>

          </div>
          <% if (!isUnlockedForUser) { %>
            <!-- Градиентное перекрытие и сканер над размытым текстом -->
            <div class="absolute z-10 inset-0 pointer-events-none overflow-hidden rounded-2xl">
              <div class="absolute inset-0 bg-gradient-to-t from-white via-white/60 to-transparent dark:from-slate-800 dark:via-slate-800/60 dark:to-transparent"></div>
              <div
                class="absolute top-0 left-0 w-full h-[2px] bg-brand shadow-[0_0_15px_3px_rgba(0,119,255,0.8)] animate-scan">
              </div>
            </div>

            <!-- Сама карточка пейволла в нормальном потоке, отцентрованная -->
            <div id="paywall-overlay"
              class="relative z-20 w-full flex flex-col items-center p-4 md:p-6 pe-none">

              <div
                class="bg-gradient-to-b from-slate-800 to-slate-950 border-2 border-brand/80 shadow-[0_0_40px_-10px_rgba(0,119,255,0.7)] rounded-2xl p-5 md:p-6 w-full transform transition-all relative overflow-hidden pe-auto">

                <!-- Декоративные партиклы/сетка на фоне карточки -->
                <div class="absolute inset-0 opacity-30 bg-dots-pattern">
                </div>
                <!-- Дополнительный световой блик сверху -->
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-24 bg-brand/20 blur-[50px] rounded-full pointer-events-none"></div>

                <div class="relative z-10">
                  <div class="flex flex-col items-center text-center mb-4">

                    <!-- Индикатор "ИИ-анализ завершен" -->
                    <div
                      class="flex items-center justify-center gap-2 mb-3 px-3 py-1.5 bg-blue-900/60 border border-brand/50 rounded-full shadow-[0_0_15px_rgba(0,119,255,0.3)] backdrop-blur-md">
                      <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-400"></span>
                      </span>
                      <span class="text-[10px] font-bold text-blue-200 tracking-widest uppercase">Детальный ответ готов</span>
                    </div>

                    <div class="bg-gradient-to-br from-brand to-blue-400 p-2.5 rounded-xl mb-3 shadow-[0_5px_15px_rgba(0,119,255,0.5)] text-white transform -rotate-3 hover:rotate-0 transition-transform">
                      <i data-lucide="lock" class="w-6 h-6"></i>
                    </div>
                    
                    <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight drop-shadow-md mb-1">Разблокируйте полный отчет</h3>
                    <p class="text-sm md:text-base text-blue-200 font-medium leading-tight">Узнайте всё о поломке и сэкономьте на ремонте.</p>
                  </div>

                  <ul class="space-y-2.5 mb-5 text-sm text-gray-100 bg-slate-900/80 backdrop-blur-xl p-4 rounded-xl border border-brand/30 shadow-inner w-full relative">
                    <!-- Блик внутри списка -->
                    <div class="absolute -left-10 top-1/2 -translate-y-1/2 w-20 h-full bg-brand/10 blur-[30px]"></div>
                    
                    <li class="flex items-center gap-3 relative z-10">
                      <div class="bg-green-500/20 p-1.5 rounded border border-green-500/30">
                        <i data-lucide="search-check" class="w-4 h-4 text-green-400 drop-shadow-sm"></i>
                      </div>
                      <span class="leading-tight"><strong class="text-white block text-base">Причины и симптомы</strong> <span class="text-xs text-gray-300">Точный диагноз проблемы</span></span>
                    </li>
                    <li class="flex items-center gap-3 relative z-10">
                      <div class="bg-red-500/20 p-1.5 rounded border border-red-500/30">
                        <i data-lucide="shield-alert" class="w-4 h-4 text-red-400 drop-shadow-sm"></i>
                      </div>
                      <span class="leading-tight"><strong class="text-white block text-base">Защита от обмана</strong> <span class="text-xs text-gray-300">Как не переплатить на СТО</span></span>
                    </li>
                    <li class="flex items-center gap-3 relative z-10">
                      <div class="bg-orange-500/20 p-1.5 rounded border border-orange-500/30">
                        <i data-lucide="wrench" class="w-4 h-4 text-orange-400 drop-shadow-sm"></i>
                      </div>
                      <span class="leading-tight"><strong class="text-white block text-base">Сделай сам</strong> <span class="text-xs text-gray-300">Пошаговая инструкция</span></span>
                    </li>
                    <li class="flex items-center gap-3 relative z-10">
                      <div class="bg-blue-500/20 p-1.5 rounded border border-blue-500/30">
                        <i data-lucide="calculator" class="w-4 h-4 text-blue-400 drop-shadow-sm"></i>
                      </div>
                      <span class="leading-tight"><strong class="text-white block text-base">Фин. прогноз</strong> <span class="text-xs text-gray-300">Стоимость запчастей и работ</span></span>
                    </li>
                  </ul>

                  <button id="unlock-btn" onclick="ym(111154643, 'reachGoal', 'paywall_click'); return true;"
                    class="relative overflow-hidden w-full bg-gradient-to-r from-brand to-blue-500 text-white font-bold rounded-xl py-3 text-lg hover:from-blue-500 hover:to-blue-400 transition-all shadow-[0_8px_20px_rgba(0,119,255,0.6)] hover:shadow-[0_12px_25px_rgba(0,119,255,0.8)] hover:-translate-y-0.5 active:scale-[0.98] flex flex-col justify-center items-center gap-1 group border border-blue-300/50">
                    <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:animate-shimmer"></div>
                    <div class="flex items-center gap-2 relative z-10 drop-shadow-md">
                      <i data-lucide="unlock" class="w-5 h-5"></i>
                      <span>Разблокировать за <del class="opacity-70 text-sm">$1.99</del> <span class="text-green-300 font-bold text-xl ml-1">0$</span></span>
                    </div>
                    <span class="relative z-10 text-[10px] font-semibold opacity-90 uppercase tracking-widest text-blue-100 bg-black/20 px-2.5 py-0.5 rounded-full mt-0.5">В рамках открытого бета-теста</span>
                  </button>
                  <p class="text-xs text-center text-gray-400 mt-3 flex items-center justify-center gap-1.5 font-medium">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-green-400"></i> Безопасная оплата 256-bit
                  </p>
                </div>
              </div>
            </div>
            <% } %>

            <!-- Экран загрузки ИИ (скрыт по умолчанию) -->
            <div id="ai-loading-screen" class="hidden absolute inset-0 z-50 flex-col items-center justify-center p-6 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-brand/20 shadow-[0_0_30px_rgba(0,119,255,0.15)]">
              <div class="relative flex items-center justify-center w-24 h-24 mb-6">
                <!-- Пульсирующие круги -->
                <div class="absolute inset-0 bg-brand/20 rounded-full animate-ping shadow-[0_0_20px_rgba(0,119,255,0.4)]"></div>
                <div class="absolute inset-2 bg-brand/40 rounded-full animate-pulse"></div>
                <div class="absolute inset-4 bg-gradient-to-br from-brand to-blue-500 rounded-full flex items-center justify-center shadow-inner z-10">
                  <i data-lucide="cpu" class="w-8 h-8 text-white drop-shadow-md"></i>
                </div>
                <!-- Вращающийся сканер -->
                <div class="absolute -inset-2 rounded-full border-2 border-transparent border-t-brand border-r-blue-400 opacity-80 animate-spin shadow-[0_0_10px_rgba(0,119,255,0.5)]"></div>
              </div>
              <div class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-2 text-center animate-pulse">Формируем отчет...</div>
              <p class="text-gray-500 dark:text-gray-400 text-center font-medium max-w-sm">Мы анализируем технические бюллетени и базы данных СТО. Примерное время ожидания: <span class="text-brand font-bold">10-20 секунд</span></p>
            </div>
        </div>
      </div>
    </div>
    <% if (relatedReports && relatedReports.length > 0) { 
        const sectionTitle = isFallbackRelated ? 'Другие коды ошибок' : `Другие коды ошибок ${displayBrand} ${displayModel}`;
        const capitalize = str => (str || '').split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    %>
        <div class="mt-8 mb-6">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2"><i data-lucide="link" class="w-5 h-5 text-brand"></i> <%= sectionTitle %></h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            <% relatedReports.forEach(r => { %>
              <a href="/catalog/<%= encodeURIComponent(r.brand.toLowerCase()) %>/<%= encodeURIComponent(r.model.toLowerCase()) %>/<%= encodeURIComponent(r.code.toLowerCase()) %>" class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-brand/40 transition-all flex flex-col group">
                <span class="font-bold text-gray-900 dark:text-white group-hover:text-brand transition-colors text-sm whitespace-nowrap overflow-hidden text-ellipsis"><%= capitalize(r.brand) %> <%= capitalize(r.model) %> <%= r.code.toUpperCase() %></span>
                <span class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2"><%= (r.summary || '').substring(0, 60) %>...</span>
              </a>
            <% }) %>
          </div>
        </div>
    <% } %>
  </div>

  <!-- Подвал (Footer) -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
    <%- include('partials/footer') %>
  </div>


  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Feedback logic
      const feedbackButtons = document.querySelectorAll('.feedback-btn');
      const feedbackForm = document.getElementById('feedback-form');
      const feedbackSubmit = document.getElementById('feedback-submit');
      const feedbackSuccess = document.getElementById('feedback-success');
      const feedbackButtonsContainer = document.getElementById('feedback-buttons');
      const feedbackComment = document.getElementById('feedback-comment');
      const feedbackTitle = document.getElementById('feedback-title');
      let currentFeedbackType = null;
      let currentReportId = null;

      feedbackButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          currentFeedbackType = btn.dataset.type;
          currentReportId = btn.dataset.id;
          
          if (currentFeedbackType === 'like') {
            sendFeedback(currentReportId, 'like', null);
            showSuccess();
          } else {
            // dislike - show comment form
            if(feedbackButtonsContainer) feedbackButtonsContainer.classList.add('hidden');
            if(feedbackForm) feedbackForm.classList.remove('hidden');
            if(feedbackTitle) feedbackTitle.innerText = "Нам жаль. Что пошло не так?";
            if(feedbackComment) feedbackComment.focus();
          }
        });
      });

      if (feedbackSubmit) {
        feedbackSubmit.addEventListener('click', () => {
          const comment = feedbackComment ? feedbackComment.value : '';
          sendFeedback(currentReportId, 'dislike', comment);
          if(feedbackForm) feedbackForm.classList.add('hidden');
          showSuccess();
        });
      }

      function sendFeedback(id, type, comment) {
        if (!id) return;
        fetch(`/api/feedback/${id}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ type, comment })
        }).catch(err => console.error('Feedback error:', err));
      }

      function showSuccess() {
        if(feedbackButtonsContainer) feedbackButtonsContainer.classList.add('hidden');
        if (feedbackForm) feedbackForm.classList.add('hidden');
        if (feedbackTitle) feedbackTitle.classList.add('hidden');
        if (feedbackSuccess) {
          feedbackSuccess.classList.remove('hidden');
          feedbackSuccess.classList.add('animate-fade-in-up');
        }
      }

      // Share tracking logic
      const shareActionBtns = document.querySelectorAll('.share-action-btn');
      shareActionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.dataset.type;
          const id = btn.dataset.id;
          if (id && type) {
            sendFeedback(id, type, null);
          }
        });
      });

      // Copy link logic
      const copyBtns = document.querySelectorAll('.share-copy-btn');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const url = btn.dataset.url;
          navigator.clipboard.writeText(url).then(() => {
            const textSpan = btn.querySelector('.share-copy-text');
            const originalText = textSpan.innerText;
            const icon = btn.querySelector('i');
            const originalIcon = icon.getAttribute('data-lucide');
            
            textSpan.innerText = 'Скопировано!';
            icon.setAttribute('data-lucide', 'check');
            lucide.createIcons();
            
            setTimeout(() => {
              textSpan.innerText = originalText;
              icon.setAttribute('data-lucide', originalIcon);
              lucide.createIcons();
            }, 2000);
          });
        });
      });
    });

    lucide.createIcons();
    <% if (!isUnsupportedReport && report && report.is_complete === false) { %>
      (function () {
        let pollInterval = setInterval(async () => {
          try {
            const res = await fetch('/api/report-status/<%= reportId %>');
            if (res.ok) {
              const data = await res.json();
              if (data.is_complete) {
                clearInterval(pollInterval);
                window.location.reload();
              }
            }
          } catch (e) {
            console.error('Polling error:', e);
          }
        }, 4000); // Опрашиваем каждые 4 секунды
      })();
    <% } %>
  </script>
</body>

</html>