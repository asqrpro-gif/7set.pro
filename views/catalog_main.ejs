<!DOCTYPE html>
<html lang="ru">
<head>
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    }
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Архив ошибок OBD-II — 7Set.pro</title>
  <meta name="description" content="Полный архив марок автомобилей для расшифровки кодов неисправностей OBD-II.">
  <link rel="canonical" href="https://7set.pro/catalog" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = { 
      darkMode: 'class', 
      theme: { 
        extend: { 
          colors: { brand: '#0077FF', surface: '#F5F5F7' }
        } 
      } 
    }
  </script>
  <link rel="stylesheet" href="/style.css?v=2">
  <script src="/main.js?v=2" defer></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-surface dark:bg-slate-900 text-gray-900 dark:text-white font-sans antialiased min-h-screen flex flex-col justify-between">
  <div class="max-w-5xl mx-auto p-4 md:p-6 w-full flex-grow">
    <!-- Шапка (Header) -->
    <%- include('partials/header') %>

    <!-- Хлебные крошки -->
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400 overflow-x-auto whitespace-nowrap pb-2">
        <li>
          <a href="/" class="hover:text-brand flex items-center transition-colors">
            <i data-lucide="home" class="w-4 h-4 mr-1"></i> Главная
          </a>
        </li>
        <li class="flex items-center space-x-2" aria-current="page">
          <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
          <span class="font-semibold text-gray-900 dark:text-white">Архив</span>
        </li>
      </ol>
    </nav>

    <!-- Архив Марок -->
    <main class="mb-16 relative py-4">
      <div class="text-center mb-10 pt-2">
        <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-3">Архив ошибок по маркам</h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm md:text-base max-w-xl mx-auto">Выберите вашу марку автомобиля для просмотра доступных расшифровок</p>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 max-w-6xl mx-auto px-2">
        <% brands.forEach(function(item) { 
            const brandMap = {
              'toyota': 'toyota', 'hyundai': 'hyundai', 'kia': 'kia', 'lada': 'lada',
              'volkswagen': 'vw', 'vw': 'vw', 'skoda': 'skoda', 'renault': 'renault',
              'nissan': 'nissan', 'chevrolet': 'chevrolet', 'ford': 'ford', 'bmw': 'bmw',
              'mercedes-benz': 'mercedes-benz', 'mercedes': 'mercedes-benz', 'audi': 'audi',
              'mazda': 'mazda', 'geely': 'geely', 'chery': 'chery',
              'mitsubishi': 'mitsubishi', 'honda': 'honda', 'lexus': 'lexus', 'haval': 'haval',
              'subaru': 'subaru', 'suzuki': 'suzuki', 'opel': 'opel', 'daewoo': 'daowoo',
              'peugeot': 'peugeot', 'uaz': 'uaz', 'gaz': 'gaz', 'changan': 'changan',
              'exeed': 'exeed', 'tank': 'tank', 'jac': 'jac', 'jetour': 'jetour',
              'omoda': 'omoda', 'faw': 'faw', 'dongfeng': 'dongfeng', 'gwm': 'gwm',
              'gac': 'gac', 'byd': 'byd', 'zeekr': 'zeekr', 'voyah': 'voyah'
            };
            const brandLower = item.brand.toLowerCase();
            const logoSlug = brandMap[brandLower];
        %>
          <a href="/catalog/<%= encodeURIComponent(brandLower) %>" class="bg-white dark:bg-slate-800 p-3 rounded-2xl border-[1.5px] border-[#0077FF] dark:border-[#0077FF] shadow-none hover:shadow-[0_0_25px_rgba(0,119,255,0.5)] transition-all group flex flex-col items-center justify-center text-center duration-300 hover:-translate-y-1">
            <% if(logoSlug) { %>
              <img src="/img/logos/<%= logoSlug %>-logo-60x60-px.webp" alt="Коды ошибок <%= item.brand %>" width="48" height="48" class="object-contain mb-3 drop-shadow-sm group-hover:scale-110 transition-transform duration-300 order-1 shrink-0">
            <% } else { %>
              <div class="w-12 h-12 mb-3 bg-blue-500/10 text-brand dark:text-blue-400 rounded-full flex items-center justify-center group-hover:bg-brand group-hover:text-white transition-colors duration-300 shadow-sm order-1 shrink-0">
                <i data-lucide="car-front" class="w-6 h-6"></i>
              </div>
            <% } %>
            <h3 class="font-bold text-sm sm:text-base text-gray-900 dark:text-white capitalize group-hover:text-brand transition-colors order-2"><%= item.brand %></h3>
            <span class="text-[10px] sm:text-xs font-semibold text-blue-700 dark:text-blue-300 bg-blue-500/10 dark:bg-blue-500/20 px-2 py-0.5 rounded-full mt-2 order-3"><%= item._count.brand %> кодов</span>
          </a>
        <% }); %>
        <% if(brands.length === 0) { %>
           <p class="text-gray-500 text-center col-span-full">База данных наполняется...</p>
        <% } %>
      </div>
    </main>
  </div>
  
  <!-- Подвал (Footer) -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
    <%- include('partials/footer') %>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>
