<%- include('admin_layout_header', { title: 'Операции SEO', page: 'seo-ops' }) %>

<div class="bg-slate-800 rounded-xl border border-slate-700 shadow-sm flex flex-col h-[calc(100vh-100px)]">
    <!-- Header -->
    <div class="p-4 border-b border-slate-700 bg-slate-800/50">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">Сканер мусорных карточек</h2>
                <p class="text-xs text-slate-400 mt-1">Найдено карточек: <%= cards.length %></p>
            </div>
            
            <div class="flex items-center gap-2">
                <button id="scanBtn" onclick="toggleScan()" class="<%= scanRunning ? 'bg-red-600 hover:bg-red-500' : 'bg-blue-600 hover:bg-blue-500' %> text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 shrink-0">
                    <% if (scanRunning) { %>
                        <i data-lucide="square" class="w-4 h-4"></i> Остановить скан
                    <% } else { %>
                        <i data-lucide="play" class="w-4 h-4"></i> Запустить скан
                    <% } %>
                </button>
            </div>
        </div>

        <div class="mt-4 flex flex-col lg:flex-row justify-between gap-4 lg:items-center">
            <div class="flex gap-2">
                <button id="restoreBtn" onclick="restoreSelected()" class="bg-slate-700 hover:bg-slate-600 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    <i data-lucide="undo-2" class="w-4 h-4"></i> Вернуть из мусора (<span id="restoreCount">0</span>)
                </button>
                <button id="deleteBtn" onclick="deleteSelected()" class="bg-red-600/20 hover:bg-red-600 border border-red-500/30 text-red-400 hover:text-white px-3 py-1.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    <i data-lucide="trash-2" class="w-4 h-4"></i> Удалить навсегда (<span id="selectedCount">0</span>)
                </button>
            </div>
        </div>
        
        <!-- Terminal (hidden initially) -->
        <div id="scanTerminalWrapper" class="bg-[#0c0c0c] border border-slate-700 rounded-lg overflow-hidden h-[150px] flex flex-col mt-4 <%= !scanRunning ? 'hidden' : '' %>">
            <div class="bg-slate-700/50 px-3 py-1.5 border-b border-slate-700 flex justify-between items-center text-xs">
                <span class="text-slate-300 font-mono">Консоль scan_seo.js</span>
                <span class="flex items-center gap-2" id="scanStatusIndicator">
                    <% if (scanRunning) { %>
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Работает
                    <% } else { %>
                        Остановлен
                    <% } %>
                </span>
            </div>
            <pre id="scanTerminal" class="flex-1 p-3 overflow-y-auto text-green-400 font-mono text-xs whitespace-pre-wrap">Подключение терминала...</pre>
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-y-auto flex-1 p-0">
        <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 bg-slate-900 border-b border-slate-700 z-10">
                <tr class="text-slate-300 text-sm">
                    <th class="p-4 w-12 text-center">
                        <input type="checkbox" id="selectAll" onclick="toggleAll(this)" class="w-4 h-4 rounded border-slate-600 bg-slate-700 text-blue-600 focus:ring-blue-500 focus:ring-offset-slate-800">
                    </th>
                    <th class="p-4 font-medium text-left">Карточка (Марка/Модель/Код)</th>
                    <th class="p-4 font-medium text-left">Описание причины</th>
                    <th class="p-4 font-medium w-32 text-center">Тип мусора</th>
                    <th class="p-4 font-medium w-24 text-right">Действие</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-700/50">
                <% if (cards.length === 0) { %>
                    <tr>
                        <td colspan="5" class="p-8 text-center text-slate-400">
                            Мусорных карточек не найдено. База чиста! ✨
                        </td>
                    </tr>
                <% } %>
                <% cards.forEach(card => { %>
                    <tr class="hover:bg-slate-700/30 transition-colors">
                        <td class="p-4 text-center">
                            <input type="checkbox" value="<%= card.id %>" class="card-checkbox w-4 h-4 rounded border-slate-600 bg-slate-700 text-blue-600 focus:ring-blue-500 focus:ring-offset-slate-800" onchange="updateSelection()">
                        </td>
                        <td class="p-4">
                            <a href="/catalog/<%= card.brand.toLowerCase() %>/<%= card.model.toLowerCase() %>/<%= card.code.toLowerCase() %>" target="_blank" class="hover:underline flex items-center gap-2 w-fit">
                                <span class="font-medium text-blue-400"><%= card.brand.charAt(0).toUpperCase() + card.brand.slice(1).toLowerCase() %> <%= card.model.charAt(0).toUpperCase() + card.model.slice(1).toLowerCase() %></span>
                                <span class="text-slate-300 font-mono font-bold bg-slate-700/50 border border-slate-600 px-1.5 py-0.5 rounded text-xs"><%= card.code.toUpperCase() %></span>
                            </a>
                        </td>
                        <td class="p-4">
                            <div class="text-slate-300 line-clamp-2" title="<%= card.summary %>"><%= card.summary %></div>
                        </td>
                        <td class="p-4 text-center">
                            <% if (card.reason === 'Дубликат') { %>
                                <span class="bg-red-500/10 text-red-400 text-xs px-2 py-1 rounded border border-red-500/30 font-medium whitespace-nowrap"><i data-lucide="copy" class="w-3 h-3 inline mr-1"></i>Дубликат</span>
                            <% } else { %>
                                <span class="bg-yellow-500/10 text-yellow-400 text-xs px-2 py-1 rounded border border-yellow-500/30 font-medium whitespace-nowrap"><i data-lucide="bot" class="w-3 h-3 inline mr-1"></i>Шаблон ИИ</span>
                            <% } %>
                        </td>
                        <td class="p-4 text-right">
                            <a href="/catalog/<%= card.brand.toLowerCase() %>/<%= card.model.toLowerCase() %>/<%= card.code.toLowerCase() %>" target="_blank" class="text-blue-400 hover:text-blue-300 inline-flex items-center gap-1 text-xs bg-blue-500/10 px-2 py-1 rounded border border-blue-500/20 transition-colors">
                                <i data-lucide="eye" class="w-3 h-3"></i> Смотреть
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
    let isRunning = <%= scanRunning %>;
    let logInterval = null;

    if (isRunning) {
        startLogPolling();
    }

    async function toggleScan() {
        const action = isRunning ? 'stop' : 'start';
        const msg = isRunning ? 'Остановить сканирование?' : 'Запустить сканирование базы?';
        if (!confirm(msg)) return;

        try {
            const res = await fetch(`/admin/api/scripts/${action}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ script: 'scan_seo.js' })
            });

            if (res.ok) {
                if (action === 'start') {
                    isRunning = true;
                    document.getElementById('scanTerminalWrapper').classList.remove('hidden');
                    const scanBtn = document.getElementById('scanBtn');
                    scanBtn.className = 'bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 shrink-0';
                    scanBtn.innerHTML = '<i data-lucide="square" class="w-4 h-4"></i> Остановить скан';
                    document.getElementById('scanStatusIndicator').innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Работает';
                    lucide.createIcons();
                    startLogPolling();
                } else {
                    window.location.reload();
                }
            } else {
                const err = await res.json();
                alert(err.error || 'Ошибка');
            }
        } catch (e) {
            alert('Сетевая ошибка');
        }
    }

    function startLogPolling() {
        if (logInterval) clearInterval(logInterval);
        fetchLogs();
        logInterval = setInterval(fetchLogs, 1000);
    }

    async function fetchLogs() {
        try {
            const res = await fetch(`/admin/api/scripts/logs?script=scan_seo.js`);
            const data = await res.json();
            
            const terminal = document.getElementById('scanTerminal');
            const isScrolledToBottom = terminal.scrollHeight - terminal.clientHeight <= terminal.scrollTop + 10;
            
            terminal.innerText = data.logs || 'Ожидание вывода...';
            
            if(isScrolledToBottom) {
                terminal.scrollTop = terminal.scrollHeight;
            }

            if (isRunning && !data.running) {
                isRunning = false;
                clearInterval(logInterval);
                document.getElementById('scanStatusIndicator').innerText = 'Завершено';
                setTimeout(() => window.location.reload(), 2000);
            }
        } catch(e) {}
    }

    // --- Логика таблицы ---
    function updateSelection() {
        const checkboxes = document.querySelectorAll('.card-checkbox:checked');
        const count = checkboxes.length;
        
        document.getElementById('selectedCount').innerText = count;
        document.getElementById('restoreCount').innerText = count;
        
        document.getElementById('deleteBtn').disabled = count === 0;
        document.getElementById('restoreBtn').disabled = count === 0;
        
        const allCheckboxes = document.querySelectorAll('.card-checkbox');
        document.getElementById('selectAll').checked = allCheckboxes.length > 0 && count === allCheckboxes.length;
    }

    function toggleAll(source) {
        const checkboxes = document.querySelectorAll('.card-checkbox');
        checkboxes.forEach(cb => cb.checked = source.checked);
        updateSelection();
    }

    async function deleteSelected() {
        const checkboxes = document.querySelectorAll('.card-checkbox:checked');
        const ids = Array.from(checkboxes).map(cb => cb.value);
        
        if (!confirm(`Удалить навсегда ${ids.length} карточек из базы данных?`)) return;

        document.getElementById('deleteBtn').disabled = true;
        document.getElementById('deleteBtn').innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Удаление...';
        lucide.createIcons();

        try {
            const res = await fetch('/admin/api/seo-ops/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids })
            });
            if (res.ok) window.location.reload();
            else alert('Ошибка удаления');
        } catch (e) {
            alert('Сетевая ошибка');
        }
    }

    async function restoreSelected() {
        const checkboxes = document.querySelectorAll('.card-checkbox:checked');
        const ids = Array.from(checkboxes).map(cb => cb.value);
        
        if (!confirm(`Вернуть ${ids.length} карточек из мусора (они пропадут из этого списка)?`)) return;

        document.getElementById('restoreBtn').disabled = true;
        document.getElementById('restoreBtn').innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Восстановление...';
        lucide.createIcons();

        try {
            const res = await fetch('/admin/api/seo-ops/restore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids })
            });
            if (res.ok) window.location.reload();
            else alert('Ошибка восстановления');
        } catch (e) {
            alert('Сетевая ошибка');
        }
    }
</script>

<%- include('admin_layout_footer') %>
