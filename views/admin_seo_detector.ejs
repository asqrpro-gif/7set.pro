<%- include('admin_layout_header', { title: 'Контроль Качества SEO', page: 'seo-detector' }) %>
<%
    let baseQueryParams = '';
    if (typeof currentRisk !== 'undefined' && currentRisk && currentRisk !== 'ALL' && !showDuplicates) baseQueryParams += '&risk=' + currentRisk;
    if (typeof showDuplicates !== 'undefined' && showDuplicates) baseQueryParams += '&duplicates=true';
    if (typeof currentPublishStatus !== 'undefined' && currentPublishStatus) baseQueryParams += '&publish_status=' + currentPublishStatus;
    
    // Для ссылок во вкладках (сохраняют publish_status, но меняют risk/duplicates)
    let tabsQueryParams = '';
    if (typeof currentPublishStatus !== 'undefined' && currentPublishStatus) tabsQueryParams += '&publish_status=' + currentPublishStatus;
    if (typeof currentSort !== 'undefined' && currentSort) tabsQueryParams += '&sort=' + currentSort;
    if (typeof currentOrder !== 'undefined' && currentOrder) tabsQueryParams += '&order=' + currentOrder;

    // Для ссылок во вкладках Publish (сохраняют risk/duplicates, меняют publish_status)
    let publishTabsQueryParams = '';
    if (typeof currentRisk !== 'undefined' && currentRisk && currentRisk !== 'ALL' && !showDuplicates) publishTabsQueryParams += '&risk=' + currentRisk;
    if (typeof showDuplicates !== 'undefined' && showDuplicates) publishTabsQueryParams += '&duplicates=true';
    if (typeof currentSort !== 'undefined' && currentSort) publishTabsQueryParams += '&sort=' + currentSort;
    if (typeof currentOrder !== 'undefined' && currentOrder) publishTabsQueryParams += '&order=' + currentOrder;

    // Параметры второй таблицы (чтобы не сбрасывались при кликах в первой таблице)
    let table2Params = '';
    if (typeof linkFilter !== 'undefined' && linkFilter !== 'ALL') table2Params += '&link_filter=' + linkFilter;
    if (typeof linkSort !== 'undefined' && linkSort !== 'date') table2Params += '&link_sort=' + linkSort;
    if (typeof linkOrder !== 'undefined' && linkOrder !== 'desc') table2Params += '&link_order=' + linkOrder;
    if (typeof linkPublishStatus !== 'undefined' && linkPublishStatus) table2Params += '&link_publish_status=' + linkPublishStatus;

    tabsQueryParams += table2Params;
    publishTabsQueryParams += table2Params;
    baseQueryParams += table2Params;

    // Параметры первой таблицы (чтобы не сбрасывались при кликах во второй таблице)
    let table1Params = '';
    if (typeof currentRisk !== 'undefined' && currentRisk && currentRisk !== 'ALL' && !showDuplicates) table1Params += '&risk=' + currentRisk;
    if (typeof showDuplicates !== 'undefined' && showDuplicates) table1Params += '&duplicates=true';
    if (typeof currentPublishStatus !== 'undefined' && currentPublishStatus) table1Params += '&publish_status=' + currentPublishStatus;
    if (typeof currentSort !== 'undefined' && currentSort) table1Params += '&sort=' + currentSort;
    if (typeof currentOrder !== 'undefined' && currentOrder) table1Params += '&order=' + currentOrder;

    // Ссылки для вкладок Publish во второй таблице
    let table2PublishParams = table1Params;
    if (typeof linkFilter !== 'undefined' && linkFilter !== 'ALL') table2PublishParams += '&link_filter=' + linkFilter;
    if (typeof linkSort !== 'undefined' && linkSort !== 'date') table2PublishParams += '&link_sort=' + linkSort;
    if (typeof linkOrder !== 'undefined' && linkOrder !== 'desc') table2PublishParams += '&link_order=' + linkOrder;

    // Параметры третьей таблицы
    let table3Params = '';
    if (typeof titlePublishStatus !== 'undefined' && titlePublishStatus) table3Params += '&title_publish_status=' + titlePublishStatus;
    if (typeof titleSort !== 'undefined' && titleSort !== 'card') table3Params += '&title_sort=' + titleSort;
    if (typeof titleOrder !== 'undefined' && titleOrder !== 'asc') table3Params += '&title_order=' + titleOrder;

    tabsQueryParams += table3Params;
    publishTabsQueryParams += table3Params;
    baseQueryParams += table3Params;
    table1Params += table3Params;
    table2PublishParams += table3Params;

    // Ссылки для вкладок Publish в третьей таблице
    let table3PublishParams = table1Params;
    if (typeof linkFilter !== 'undefined' && linkFilter !== 'ALL') table3PublishParams += '&link_filter=' + linkFilter;
    if (typeof linkSort !== 'undefined' && linkSort !== 'date') table3PublishParams += '&link_sort=' + linkSort;
    if (typeof linkOrder !== 'undefined' && linkOrder !== 'desc') table3PublishParams += '&link_order=' + linkOrder;
    if (typeof linkPublishStatus !== 'undefined' && linkPublishStatus) table3PublishParams += '&link_publish_status=' + linkPublishStatus;

    // Функция для генерации ссылок сортировки 3-й таблицы
    function getTitleSortLink(field) {
        let order = 'asc';
        if (typeof titleSort !== 'undefined' && titleSort === field && typeof titleOrder !== 'undefined' && titleOrder === 'asc') {
            order = 'desc';
        }
        return `/admin/seo-detector?mode=seo&title_sort=${field}&title_order=${order}${table3PublishParams}#problematic-titles`;
    }

    // Функция для генерации ссылок сортировки
    function getSortLink(field) {
        let order = 'asc';
        if (typeof currentSort !== 'undefined' && currentSort === field && currentOrder === 'asc') {
            order = 'desc';
        }
        return `?sort=${field}&order=${order}${baseQueryParams}`;
    }

    // Для пагинации (нужны все параметры)
    let paginationParams = baseQueryParams;
    if (typeof currentSort !== 'undefined' && currentSort) paginationParams += '&sort=' + currentSort;
    if (typeof currentOrder !== 'undefined' && currentOrder) paginationParams += '&order=' + currentOrder;
%>
<details class="bg-slate-800 rounded-xl border border-slate-700 shadow-sm group">
    <summary class="p-4 cursor-pointer list-none flex justify-between items-center font-semibold text-white select-none [&::-webkit-details-marker]:hidden border-b border-slate-700 bg-slate-800/50 hover:bg-slate-700/50 transition-colors">
        <div class="flex items-center gap-2">
            <i data-lucide="list-checks" class="w-5 h-5 text-blue-400"></i>
            Качество карточек
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs font-medium bg-slate-700 px-2 py-1 rounded-md text-slate-300"><%= total %> шт.</span>
            <i data-lucide="chevron-down" class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform"></i>
        </div>
    </summary>
    <div class="flex flex-col max-h-[500px]">
    <div class="p-3 border-b border-slate-700 bg-slate-800/50">
        <div class="flex items-center justify-end gap-3 text-xs border-b border-slate-700/50 pb-2">
            <div class="flex items-center gap-1.5">
                <span class="text-slate-400">Скан:</span>
                <span class="font-medium text-white"><%= scanStats.scanned %>/<%= scanStats.total %></span>
                <% if (scanStats.scanned < scanStats.total) { %><i data-lucide="loader-2" class="w-3 h-3 text-blue-400 animate-spin"></i><% } else { %><i data-lucide="check-circle" class="w-3 h-3 text-green-400"></i><% } %>
            </div>
            <% if (scanStats.lastScanTime) { %><div class="text-slate-500 border-l border-slate-700 pl-3"><%= scanStats.lastScanTime %></div><% } %>
        </div>

        <div class="mt-3 flex flex-col lg:flex-row justify-between gap-3 lg:items-center">
            <!-- Вкладки Risk -->
            <div class="flex gap-1.5 flex-wrap w-full lg:w-auto">
                <a href="/admin/seo-detector?risk=ALL<%= tabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= currentRisk === 'ALL' && !showDuplicates ? 'bg-blue-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Все <span class="<%= currentRisk === 'ALL' && !showDuplicates ? 'bg-blue-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= stats.total %></span>
                </a>
                <a href="?risk=SAFE<%= tabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= currentRisk === 'SAFE' && !showDuplicates ? 'bg-green-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Удачные <span class="<%= currentRisk === 'SAFE' && !showDuplicates ? 'bg-green-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= stats.safe %></span>
                </a>
                <a href="?risk=WARNING<%= tabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= currentRisk === 'WARNING' && !showDuplicates ? 'bg-yellow-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Неудачные <span class="<%= currentRisk === 'WARNING' && !showDuplicates ? 'bg-yellow-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= stats.warning %></span>
                </a>
                <a href="?duplicates=true<%= tabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= showDuplicates ? 'bg-purple-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Дубликаты <span class="<%= showDuplicates ? 'bg-purple-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= duplicatesCount %></span>
                </a>
            </div>

            <!-- Вкладки Publish Status -->
            <div class="flex gap-1.5 flex-wrap w-full lg:w-auto">
                <div class="hidden lg:block w-px h-7 bg-slate-700 mx-1"></div>
                <a href="?publish_status=<%= publishTabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= (!currentPublishStatus) ? 'bg-slate-600 text-white shadow-inner' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Все статусы <span class="<%= (!currentPublishStatus) ? 'bg-slate-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= publishStats.total %></span>
                </a>
                <a href="?publish_status=PUBLISHED<%= publishTabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= (currentPublishStatus === 'PUBLISHED') ? 'bg-blue-600 text-white shadow-inner' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Опубликовано <span class="<%= (currentPublishStatus === 'PUBLISHED') ? 'bg-blue-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= publishStats.published %></span>
                </a>
                <a href="?publish_status=UNPUBLISHED<%= publishTabsQueryParams %>" class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-2 flex-1 lg:flex-none justify-center <%= (currentPublishStatus === 'UNPUBLISHED') ? 'bg-purple-600 text-white shadow-inner' : 'bg-slate-700 text-slate-300 hover:bg-slate-600 hover:text-white' %>">
                    Отложено <span class="<%= (currentPublishStatus === 'UNPUBLISHED') ? 'bg-purple-700' : 'bg-slate-800' %> px-1.5 py-0.5 rounded text-[10px]"><%= publishStats.unpublished %></span>
                </a>
            </div>
        </div>
    </div>

    <div class="overflow-auto flex-1 p-0 min-h-0">
        <table class="w-full text-left border-collapse min-w-[700px]">
            <thead class="sticky top-0 bg-slate-900 border-b border-slate-700 z-10">
                <tr class="text-slate-300 text-xs">
                    <th class="px-2 py-2.5 font-medium text-left">
                        <a href="<%= getSortLink('brand') %>" class="inline-flex items-center gap-1 hover:text-white transition-colors">
                            Карточка
                            <% if (typeof currentSort !== 'undefined' && currentSort === 'brand') { %><i data-lucide="<%= currentOrder === 'desc' ? 'arrow-down' : 'arrow-up' %>" class="w-3 h-3 text-blue-400"></i><% } else { %><i data-lucide="arrow-up-down" class="w-3 h-3 opacity-30"></i><% } %>
                        </a>
                    </th>
                    <th class="px-2 py-2.5 font-medium text-center">
                        <a href="<%= getSortLink('seoScore') %>" class="inline-flex items-center gap-1 hover:text-white transition-colors">
                            Оценка СЕО
                            <% if (typeof currentSort !== 'undefined' && currentSort === 'seoScore') { %><i data-lucide="<%= currentOrder === 'desc' ? 'arrow-down' : 'arrow-up' %>" class="w-3 h-3 text-blue-400"></i><% } else { %><i data-lucide="arrow-up-down" class="w-3 h-3 opacity-30"></i><% } %>
                        </a>
                    </th>
                    <th class="px-2 py-2.5 font-medium text-center">
                        <a href="<%= getSortLink('uniquenessScore') %>" class="inline-flex items-center gap-1 hover:text-white transition-colors">
                            Текст
                            <% if (typeof currentSort !== 'undefined' && currentSort === 'uniquenessScore') { %><i data-lucide="<%= currentOrder === 'desc' ? 'arrow-down' : 'arrow-up' %>" class="w-3 h-3 text-blue-400"></i><% } else { %><i data-lucide="arrow-up-down" class="w-3 h-3 opacity-30"></i><% } %>
                        </a>
                    </th>
                    <th class="px-2 py-2.5 font-medium text-center w-28">
                        <a href="<%= getSortLink('seoRisk') %>" class="inline-flex items-center justify-center gap-1 hover:text-white transition-colors">
                            Статус
                            <% if (typeof currentSort !== 'undefined' && currentSort === 'seoRisk') { %><i data-lucide="<%= currentOrder === 'desc' ? 'arrow-down' : 'arrow-up' %>" class="w-3 h-3 text-blue-400"></i><% } else { %><i data-lucide="arrow-up-down" class="w-3 h-3 opacity-30"></i><% } %>
                        </a>
                    </th>
                    <th class="px-2 py-2.5 font-medium text-center w-32">
                        <a href="<%= getSortLink('created_at') %>" class="inline-flex items-center justify-center gap-1 hover:text-white transition-colors">
                            Публикация
                            <% if (typeof currentSort !== 'undefined' && currentSort === 'created_at') { %><i data-lucide="<%= currentOrder === 'desc' ? 'arrow-down' : 'arrow-up' %>" class="w-3 h-3 text-blue-400"></i><% } else { %><i data-lucide="arrow-up-down" class="w-3 h-3 opacity-30"></i><% } %>
                        </a>
                    </th>
                    <th class="px-2 py-2.5 font-medium text-right w-36">Действия</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-700/50">
                <% reports.forEach(report => { %>
                    <tr class="hover:bg-slate-700/30 transition-colors" data-report-id="<%= report.id %>">
                        <td class="px-2 py-2">
                            <a href="/catalog/<%= report.brand.toLowerCase() %>/<%= report.model.toLowerCase() %>/<%= report.code.toLowerCase() %>" target="_blank" class="hover:underline flex items-center gap-1.5 w-fit">
                                <span class="font-medium text-blue-400 text-xs sm:text-sm whitespace-nowrap"><%= report.brand.charAt(0).toUpperCase() + report.brand.slice(1).toLowerCase() %> <%= report.model.charAt(0).toUpperCase() + report.model.slice(1).toLowerCase() %></span>
                                <span class="text-slate-300 font-mono font-bold bg-slate-700/50 border border-slate-600 px-1 rounded text-[10px] sm:text-xs"><%= report.code.toUpperCase() %></span>
                            </a>
                        </td>
                        <td class="px-2 py-2 text-center">
                            <% 
                                let scoreColor = 'text-green-400';
                                if(report.seoRisk === 'WARNING') scoreColor = 'text-yellow-400';
                                if(report.seoRisk === 'DANGER') scoreColor = 'text-red-400';
                            %>
                            <span class="text-sm sm:text-base font-bold <%= scoreColor %>"><%= report.seoScore %></span>
                        </td>
                        <td class="px-2 py-2 text-center">
                            <% 
                                let uScore = report.uniquenessScore || 0;
                                let uColor = 'text-green-400 bg-green-500/10 border-green-500/30';
                                if(uScore < 50) uColor = 'text-yellow-400 bg-yellow-500/10 border-yellow-500/30';
                                if(uScore < 30) uColor = 'text-red-400 bg-red-500/10 border-red-500/30 font-bold';
                            %>
                            <span class="inline-block px-1.5 py-0.5 rounded border text-[10px] sm:text-xs <%= uColor %>">
                                <%= uScore %>%
                            </span>
                        </td>
                        <td class="px-2 py-2 text-center">
                            <% if (report.seoRisk === 'SAFE') { %>
                                <span class="bg-green-500/10 text-green-400 text-[10px] px-1.5 py-0.5 rounded border border-green-500/30 font-medium">Успешно</span>
                            <% } else if (report.seoRisk === 'WARNING') { %>
                                <span class="bg-yellow-500/10 text-yellow-400 text-[10px] px-1.5 py-0.5 rounded border border-yellow-500/30 font-medium">Внимание</span>
                            <% } else { %>
                                <span class="bg-red-500/10 text-red-400 text-[10px] px-1.5 py-0.5 rounded border border-red-500/30 font-medium">Критично</span>
                            <% } %>
                        </td>
                        <td class="px-2 py-2 text-center">
                            <% 
                                const isPublished = new Date(report.created_at) <= new Date();
                                const isFarFuture = new Date(report.created_at).getFullYear() === 2099;
                            %>
                            <% if (isPublished) { %>
                                <span class="text-blue-400 text-[10px] leading-tight flex flex-col items-center">
                                    <span>Опубликовано</span>
                                    <span class="opacity-70"><%= new Date(report.created_at).toLocaleDateString('ru-RU') %></span>
                                </span>
                            <% } else if (isFarFuture) { %>
                                <span class="text-slate-400 text-[10px] flex flex-col items-center">Снято</span>
                            <% } else { %>
                                <span class="text-purple-400 text-[10px] leading-tight flex flex-col items-center">
                                    <span>Отложено</span>
                                    <span class="opacity-70"><%= new Date(report.created_at).toLocaleDateString('ru-RU') %></span>
                                </span>
                            <% } %>
                        </td>
                        <td class="px-2 py-2 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <% const isEnriched = !!report.tools_table_md || (report.seoScore === 95 && report.uniquenessScore === 100); %>
                                <% if (isEnriched) { %>
                                    <button disabled title="Уже обогащено" class="w-10 h-10 md:w-8 md:h-8 flex items-center justify-center text-emerald-400 cursor-default rounded">
                                        <i data-lucide="check-circle" class="w-4 h-4"></i>
                                    </button>
                                <% } else { %>
                                    <button id="enrich-btn-<%= report.id %>" onclick="enrichCard('<%= report.id %>')" title="СЕО Обогащение (ИИ)" class="w-10 h-10 md:w-8 md:h-8 flex items-center justify-center text-slate-400 hover:text-emerald-400 hover:bg-slate-700 rounded transition-colors">
                                        <i data-lucide="sparkles" id="enrich-icon-<%= report.id %>" class="w-4 h-4"></i>
                                    </button>
                                <% } %>
                                <% const hasRetroLinks = (report.full_analysis_markdown || report.summary || '').includes('ПДД и эксплуатация') || (report.full_analysis_markdown || report.summary || '').includes('ПДД и полезные ресурсы'); %>
                                <button class="btn-enrich-single w-10 h-10 md:w-8 md:h-8 flex items-center justify-center rounded transition-colors <%= hasRetroLinks ? 'text-emerald-400 hover:text-emerald-300' : 'text-rose-400 hover:text-rose-300 hover:bg-slate-700' %>" data-id="<%= report.id %>" title="SEO Обогащение (Словари)">
                                    <i data-lucide="link" class="w-4 h-4"></i>
                                </button>
                                <% if (isPublished) { %>
                                    <button onclick="unpublishCard('<%= report.id %>')" title="Снять с публикации" class="w-10 h-10 md:w-8 md:h-8 flex items-center justify-center text-slate-400 hover:text-yellow-400 hover:bg-slate-700 rounded transition-colors">
                                        <i data-lucide="clock" class="w-4 h-4"></i>
                                    </button>
                                <% } else { %>
                                    <button onclick="publishCard('<%= report.id %>')" title="Опубликовать сейчас" class="w-10 h-10 md:w-8 md:h-8 flex items-center justify-center text-slate-400 hover:text-green-400 hover:bg-slate-700 rounded transition-colors">
                                        <i data-lucide="check-circle" class="w-4 h-4"></i>
                                    </button>
                                <% } %>
                                <button onclick='openEditModal(<%- JSON.stringify(report).replace(/'/g, "&apos;") %>)' title="Редактировать" class="w-10 h-10 md:w-8 md:h-8 flex items-center justify-center text-slate-400 hover:text-blue-400 hover:bg-slate-700 rounded transition-colors">
                                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteCard('<%= report.id %>')" title="Удалить" class="w-10 h-10 md:w-8 md:h-8 flex items-center justify-center text-slate-400 hover:text-red-400 hover:bg-slate-700 rounded transition-colors">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <div class="p-4 border-t border-slate-700 bg-slate-800/50 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-sm text-slate-400">
            Всего карточек: <strong><%= currentRisk === 'ALL' ? stats.total : (currentRisk === 'SAFE' ? stats.safe : (currentRisk === 'WARNING' ? stats.warning : stats.danger)) %></strong>
        </div>
        
        <div class="flex items-center gap-1">
            <!-- Кнопки Назад -->
            <% if (page > 1) { %>
                <a href="?page=1<%= paginationParams %>" class="p-1.5 bg-slate-700 text-slate-300 rounded hover:text-white hover:bg-slate-600 transition-colors" title="Первая страница">
                    <i data-lucide="chevrons-left" class="w-4 h-4"></i>
                </a>
                <a href="?page=<%= page - 1 %><%= paginationParams %>" class="p-1.5 bg-slate-700 text-slate-300 rounded hover:text-white hover:bg-slate-600 transition-colors" title="Предыдущая">
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                </a>
            <% } else { %>
                <span class="p-1.5 bg-slate-800 text-slate-600 rounded cursor-not-allowed">
                    <i data-lucide="chevrons-left" class="w-4 h-4"></i>
                </span>
                <span class="p-1.5 bg-slate-800 text-slate-600 rounded cursor-not-allowed">
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                </span>
            <% } %>

            <!-- Поле ввода -->
            <form method="GET" action="/admin/seo-detector" class="flex items-center mx-2 bg-slate-900/50 rounded border border-slate-700">
                <% if (typeof currentRisk !== 'undefined' && currentRisk && currentRisk !== 'ALL' && !showDuplicates) { %><input type="hidden" name="risk" value="<%= currentRisk %>"><% } %>
                <% if (typeof showDuplicates !== 'undefined' && showDuplicates) { %><input type="hidden" name="duplicates" value="true"><% } %>
                <% if (typeof currentPublishStatus !== 'undefined' && currentPublishStatus) { %><input type="hidden" name="publish_status" value="<%= currentPublishStatus %>"><% } %>
                <% if (typeof currentSort !== 'undefined' && currentSort) { %><input type="hidden" name="sort" value="<%= currentSort %>"><% } %>
                <% if (typeof currentOrder !== 'undefined' && currentOrder) { %><input type="hidden" name="order" value="<%= currentOrder %>"><% } %>
                
                <input type="number" name="page" value="<%= page %>" min="1" max="<%= totalPages %>" class="w-12 px-1 py-1 text-center bg-transparent text-white text-sm outline-none no-spinners">
                <span class="text-slate-500 text-sm px-2 border-l border-slate-700">из <%= totalPages %></span>
            </form>

            <!-- Кнопки Вперед -->
            <% if (page < totalPages) { %>
                <a href="?page=<%= page + 1 %><%= paginationParams %>" class="p-1.5 bg-slate-700 text-slate-300 rounded hover:text-white hover:bg-slate-600 transition-colors" title="Следующая">
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </a>
                <a href="?page=<%= totalPages %><%= paginationParams %>" class="p-1.5 bg-slate-700 text-slate-300 rounded hover:text-white hover:bg-slate-600 transition-colors" title="Последняя страница">
                    <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                </a>
            <% } else { %>
                <span class="p-1.5 bg-slate-800 text-slate-600 rounded cursor-not-allowed">
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </span>
                <span class="p-1.5 bg-slate-800 text-slate-600 rounded cursor-not-allowed">
                    <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                </span>
            <% } %>
        </div>
    </div>
    </div>
</details>

<details class="bg-slate-800 rounded-xl border border-slate-700 shadow-sm group mt-4" id="broken-links">
