                                <button onclick="changePage('tab-links', 'link_page', <%= linkPage - 1 %>)" class="w-8 h-8 flex items-center justify-center rounded bg-slate-700 text-slate-300 hover:text-white hover:bg-slate-600 transition-colors" title="Предыдущая">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </button>
                            <% } else { %>
                                <span class="w-8 h-8 flex items-center justify-center rounded bg-slate-800 text-slate-600 cursor-not-allowed">
                                    <i data-lucide="chevrons-left" class="w-4 h-4"></i>
                                </span>
                                <span class="w-8 h-8 flex items-center justify-center rounded bg-slate-800 text-slate-600 cursor-not-allowed">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </span>
                            <% } %>

                            <div class="flex items-center mx-2 bg-slate-900/50 rounded border border-slate-700">
                                <input type="number" value="<%= linkPage %>" min="1" max="<%= linkTotalPages %>" onchange="changePage('tab-links', 'link_page', this.value)" class="w-12 px-1 py-1 text-center bg-transparent text-white text-sm outline-none no-spinners">
                                <span class="text-slate-500 text-sm px-2 border-l border-slate-700">из <%= linkTotalPages %></span>
                            </div>

                            <% if (linkPage < linkTotalPages) { %>
                                <button onclick="changePage('tab-links', 'link_page', <%= linkPage + 1 %>)" class="w-8 h-8 flex items-center justify-center rounded bg-slate-700 text-slate-300 hover:text-white hover:bg-slate-600 transition-colors" title="Следующая">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </button>
                                <button onclick="changePage('tab-links', 'link_page', <%= linkTotalPages %>)" class="w-8 h-8 flex items-center justify-center rounded bg-slate-700 text-slate-300 hover:text-white hover:bg-slate-600 transition-colors" title="Последняя страница">
                                    <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                                </button>
                            <% } else { %>
                                <span class="w-8 h-8 flex items-center justify-center rounded bg-slate-800 text-slate-600 cursor-not-allowed">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </span>
                                <span class="w-8 h-8 flex items-center justify-center rounded bg-slate-800 text-slate-600 cursor-not-allowed">
                                    <i data-lucide="chevrons-right" class="w-4 h-4"></i>
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
    </div>
</div>


<script>

async function rewriteSeoDescription(id) {
    const btn = document.getElementById('btn-rewrite-desc-' + id);
    const titleSpan = document.getElementById('desc-text-' + id);
    
    const originalHtml = btn.innerHTML;
    btn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i> Думает...';
    btn.disabled = true;
    if(typeof lucide !== 'undefined') lucide.createIcons();

    try {
        const res = await fetch('/admin/api/rewrite-description', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
        });
        const data = await res.json();
        
        if (data.success) {
            titleSpan.textContent = data.newDesc;
            titleSpan.classList.add('text-green-400');
            
            const lenSpan = document.getElementById('desc-len-' + id);
            if (lenSpan) {
                const newLen = data.newDesc.length;
                lenSpan.textContent = newLen;
                if (newLen < 140 || newLen > 160) {
                    lenSpan.className = 'text-xs font-bold text-red-400';
                } else {
                    lenSpan.className = 'text-xs font-bold text-emerald-400';
                }
            }

            btn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5 text-green-400"></i> Готово';
            setTimeout(() => {
                titleSpan.classList.remove('text-green-400');
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if(typeof lucide !== 'undefined') lucide.createIcons();
            }, 3000);
        } else {
            alert('Ошибка: ' + (data.error || 'Неизвестная ошибка'));
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }
    } catch (e) {
        alert('Сетевая ошибка');
        btn.innerHTML = originalHtml;
        btn.disabled = false;
    }
    if(typeof lucide !== 'undefined') lucide.createIcons();
}


