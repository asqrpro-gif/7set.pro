                                <th class="px-2 py-2.5 font-medium hover:text-white cursor-pointer select-none" onclick="window.location.href='/admin/seo-detector?mode=seo&link_filter=<%= linkFilter %>&link_sort=date&link_order=<%= linkSort === 'date' && linkOrder === 'asc' ? 'desc' : 'asc' %><%= table1Params %>#broken-links'">
