<%- include('admin_layout_header', { title: 'SEO детектор (pSEO Quality Control)', page: 'seo-detector' }) %>

<div class="bg-slate-800 rounded-xl border border-slate-700 shadow-sm flex flex-col h-[calc(100vh-100px)]">
    <div class="p-4 border-b border-slate-700 flex flex-col md:flex-row justify-between items-center bg-slate-800/50 gap-4">
        <div>
            <h2 class="text-lg font-semibold text-white">Отчеты по качеству</h2>
            <div class="flex gap-2 mt-2">
                <a href="/admin/seo-detector?risk=ALL<%= currentBrand ? '&brand='+currentBrand : '' %><%= currentModel ? '&model='+currentModel : '' %>" class="px-3 py-1 text-xs rounded-full font-medium <%= currentRisk === 'ALL' ? 'bg-blue-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600' %> transition-colors">
                    Все (<%= stats.total %>)
                </a>
                <a href="?risk=SAFE<%= currentBrand ? '&brand='+currentBrand : '' %><%= currentModel ? '&model='+currentModel : '' %>" class="px-3 py-1 text-xs rounded-full font-medium <%= currentRisk === 'SAFE' ? 'bg-green-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600' %> transition-colors">
                    Удачные (<%= stats.safe %>)
                </a>
                <a href="?risk=WARNING<%= currentBrand ? '&brand='+currentBrand : '' %><%= currentModel ? '&model='+currentModel : '' %>" class="px-3 py-1 text-xs rounded-full font-medium <%= currentRisk === 'WARNING' ? 'bg-yellow-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600' %> transition-colors">
                    Неудачные (<%= stats.warning %>)
                </a>
                <a href="?risk=DANGER<%= currentBrand ? '&brand='+currentBrand : '' %><%= currentModel ? '&model='+currentModel : '' %>" class="px-3 py-1 text-xs rounded-full font-medium <%= currentRisk === 'DANGER' ? 'bg-red-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600' %> transition-colors">
                    Критические (<%= stats.danger %>)
                </a>
            </div>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-3">
            <form method="GET" action="/admin/seo-detector" class="flex gap-2 items-center" id="filterForm">
                <% if (currentRisk && currentRisk !== 'ALL') { %>
                    <input type="hidden" name="risk" value="<%= currentRisk %>">
                <% } %>
                <select name="brand" onchange="this.form.model ? this.form.model.value='' : null; this.form.submit()" class="bg-slate-700 text-white text-xs rounded px-2 py-1.5 border border-slate-600 outline-none min-w-[120px]">
                    <option value="">Все марки</option>
                    <% brandStats.forEach(b => { %>
                        <option value="<%= b.brand %>" <%= currentBrand === b.brand ? 'selected' : '' %>><%= b.brand.toUpperCase() %> (<%= b.count %>)</option>
                    <% }) %>
                </select>
                <% if (currentBrand && modelStats.length > 0) { %>
                <select name="model" onchange="this.form.submit()" class="bg-slate-700 text-white text-xs rounded px-2 py-1.5 border border-slate-600 outline-none min-w-[120px]">
                    <option value="">Все модели</option>
                    <% modelStats.forEach(m => { %>
                        <option value="<%= m.model %>" <%= currentModel === m.model ? 'selected' : '' %>><%= m.model.toUpperCase() %> (<%= m.count %>)</option>
                    <% }) %>
                </select>
                <% } %>
            </form>
            <button id="rescanBtn" onclick="rescanAll()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-1.5 rounded text-sm font-medium transition-colors flex items-center gap-2">
                <i data-lucide="refresh-cw" class="w-4 h-4" id="rescanIcon"></i> Пересканировать
            </button>
        </div>
    </div>

    <div class="overflow-y-auto flex-1 p-0">
        <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 bg-slate-900 border-b border-slate-700 z-10">
                <tr class="text-slate-300 text-sm">
                    <th class="p-4 font-semibold w-64">Автомобиль</th>
                    <th class="p-4 font-semibold w-24">Код</th>
                    <th class="p-4 font-semibold text-center w-24">SEO Балл</th>
                    <th class="p-4 font-semibold text-center w-32">Уникальность</th>
                    <th class="p-4 font-semibold w-32">Статус</th>
                    <th class="p-4 font-semibold text-right">Действие</th>
                </tr>
            </thead>
            <tbody class="text-sm divide-y divide-slate-700/50">
                <% reports.forEach(report => { %>
                    <tr class="hover:bg-slate-700/30 transition-colors">
                        <td class="p-4 font-medium text-blue-400">
                            <a href="/catalog/<%= report.brand.toLowerCase() %>/<%= report.model.toLowerCase() %>/<%= report.code.toLowerCase() %>" target="_blank" class="hover:underline flex items-center gap-1">
                                <%= report.brand.charAt(0).toUpperCase() + report.brand.slice(1).toLowerCase() %> <%= report.model.charAt(0).toUpperCase() + report.model.slice(1).toLowerCase() %>
                                <i data-lucide="external-link" class="w-3 h-3 text-slate-500"></i>
                            </a>
                        </td>
                        <td class="p-4 font-mono text-slate-300 font-bold"><%= report.code.toUpperCase() %></td>
                        <td class="p-4 text-center">
                            <% 
                                let scoreColor = 'text-green-400';
                                if(report.seoRisk === 'WARNING') scoreColor = 'text-yellow-400';
                                if(report.seoRisk === 'DANGER') scoreColor = 'text-red-400';
                            %>
                            <span class="text-lg font-bold <%= scoreColor %>"><%= report.seoScore %></span>
                        </td>
                        <td class="p-4 text-center">
                            <% 
                                let uScore = report.uniquenessScore || 0;
                                let uColor = 'text-green-400 bg-green-500/10 border-green-500/30';
                                if(uScore < 50) uColor = 'text-yellow-400 bg-yellow-500/10 border-yellow-500/30';
                                if(uScore < 30) uColor = 'text-red-400 bg-red-500/10 border-red-500/30 font-bold';
                            %>
                            <span class="inline-block px-2 py-1 rounded border text-xs <%= uColor %>">
                                <%= uScore %>%
                            </span>
                        </td>
                        <td class="p-4">
                            <% if (report.seoRisk === 'SAFE') { %>
                                <span class="bg-green-500/20 text-green-400 text-xs px-2 py-1 rounded border border-green-500/30">SAFE</span>
                            <% } else if (report.seoRisk === 'WARNING') { %>
                                <span class="bg-yellow-500/20 text-yellow-400 text-xs px-2 py-1 rounded border border-yellow-500/30">WARNING</span>
                            <% } else { %>
                                <span class="bg-red-500/20 text-red-400 text-xs px-2 py-1 rounded border border-red-500/30">DANGER</span>
                            <% } %>
                        </td>
                        <td class="p-4 text-right">
                            <button onclick='openEditModal(<%- JSON.stringify(report).replace(/'/g, "&apos;") %>)' class="bg-slate-700 hover:bg-slate-600 text-white px-3 py-1.5 rounded-lg text-xs transition-colors border border-slate-600 inline-flex items-center gap-1">
                                <i data-lucide="edit-2" class="w-3 h-3"></i> Редактировать
                            </button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <div class="p-4 border-t border-slate-700 bg-slate-800/50 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-sm text-slate-400">
            Всего карточек в этой вкладке: <strong><%= currentRisk === 'ALL' ? stats.total : (currentRisk === 'SAFE' ? stats.safe : (currentRisk === 'WARNING' ? stats.warning : stats.danger)) %></strong>
        </div>
        <div class="flex items-center gap-2">
            <% 
                let queryParams = '';
                if (currentRisk && currentRisk !== 'ALL') queryParams += '&risk=' + currentRisk;
                if (currentBrand) queryParams += '&brand=' + currentBrand;
                if (currentModel) queryParams += '&model=' + currentModel;
            %>
            <% if (page > 1) { %>
                <a href="?page=<%= page - 1 %><%= queryParams %>" class="px-3 py-1 bg-slate-700 text-white rounded hover:bg-slate-600">&laquo; Назад</a>
            <% } %>
            <span class="px-3 py-1 text-slate-400">Стр. <%= page %> из <%= totalPages %></span>
            <% if (page < totalPages) { %>
                <a href="?page=<%= page + 1 %><%= queryParams %>" class="px-3 py-1 bg-slate-700 text-white rounded hover:bg-slate-600">Вперед &raquo;</a>
            <% } %>
        </div>
    </div>
</div>

<!-- Модальное окно редактирования -->
<div id="editModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50 backdrop-blur-sm p-4">
    <div class="bg-slate-800 rounded-xl border border-slate-700 w-full max-w-4xl shadow-2xl flex flex-col h-[90vh]">
        <div class="p-4 border-b border-slate-700 flex justify-between items-center bg-slate-900/50 rounded-t-xl">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <i data-lucide="edit-3" class="w-5 h-5 text-blue-400"></i>
                Редактор SEO контента <span id="editModalTitle" class="text-blue-400 ml-2"></span>
            </h3>
            <button onclick="closeEditModal()" class="text-slate-400 hover:text-white transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="p-6 overflow-y-auto flex-1 flex flex-col lg:flex-row gap-6">
            <!-- Левая колонка: Детализация оценки -->
            <div class="w-full lg:w-1/3 bg-slate-900/50 rounded-xl border border-slate-700 p-4 self-start sticky top-0">
                <h4 class="text-white font-semibold mb-3 flex items-center gap-2">
                    <i data-lucide="bar-chart-2" class="w-4 h-4 text-blue-400"></i> Детализация оценки
                </h4>
                <div id="scoreDetailsContainer" class="space-y-3">
                    <!-- Заполняется через JS -->
                </div>
            </div>

            <!-- Правая колонка: Форма -->
            <div class="w-full lg:w-2/3 space-y-4">
                <input type="hidden" id="edit_id">
                
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">SEO Title (40-70 симв.)</label>
                    <input type="text" id="edit_seoTitle" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500">
                </div>
                
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">SEO Description (120-160 симв.)</label>
                    <textarea id="edit_seoDescription" rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"></textarea>
                </div>
                
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Teaser Text (Вводный абзац)</label>
                    <textarea id="edit_teaserText" rows="3" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Основной контент (Markdown, используйте ## и списки)</label>
                    <textarea id="edit_fullAnalysis" rows="10" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500 font-mono"></textarea>
                </div>
            </div>
        </div>

        <div class="p-4 border-t border-slate-700 bg-slate-900/50 flex justify-end gap-3 rounded-b-xl">
            <button onclick="closeEditModal()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-sm transition-colors">Отмена</button>
            <button onclick="saveSeoData()" id="saveBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i> Сохранить и Пересчитать
            </button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('editModal');

    async function openEditModal(report) {
        document.getElementById('edit_id').value = report.id;
        document.getElementById('editModalTitle').innerText = "Редактирование карточки";
        document.getElementById('edit_seoTitle').value = report.seoTitle || '';
        document.getElementById('edit_seoDescription').value = report.seoDescription || '';
        document.getElementById('edit_teaserText').value = report.teaser_text || '';
        document.getElementById('edit_fullAnalysis').value = report.full_analysis_markdown || '';
        
        // Показываем модалку сразу
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        const detailsContainer = document.getElementById('scoreDetailsContainer');
        detailsContainer.innerHTML = '<div class="text-slate-400 text-sm flex items-center gap-2 py-4"><i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Вычисление дубликатов и разбор баллов...</div>';
        lucide.createIcons();

        try {
            // Асинхронно запрашиваем детализацию (с тяжелым поиском дубликатов)
            const res = await fetch('/admin/api/seo-detector/details/' + report.id);
            const data = await res.json();
            
            detailsContainer.innerHTML = '';
            
            if (data.success && data.details && data.details.length > 0) {
                data.details.forEach(detail => {
                    let icon = 'check-circle';
                    let colorClass = 'text-green-400';
                    let bgClass = 'bg-green-500/10 border-green-500/20';
                    
                    if (detail.status === 'warning') {
                        icon = 'alert-triangle';
                        colorClass = 'text-yellow-400';
                        bgClass = 'bg-yellow-500/10 border-yellow-500/20';
                    } else if (detail.status === 'danger') {
                        icon = 'x-circle';
                        colorClass = 'text-red-400';
                        bgClass = 'bg-red-500/10 border-red-500/20';
                    }

                    detailsContainer.innerHTML += `
                        <div class="p-3 rounded-lg border ${bgClass}">
                            <div class="flex justify-between items-start mb-1">
                                <span class="font-medium text-sm ${colorClass} flex items-center gap-1.5">
                                    <i data-lucide="${icon}" class="w-4 h-4"></i> ${detail.label}
                                </span>
                                <span class="text-xs font-bold text-white bg-slate-800 px-1.5 py-0.5 rounded">${detail.score}/${detail.max}</span>
                            </div>
                            <p class="text-xs text-slate-300 leading-relaxed">${detail.text}</p>
                        </div>
                    `;
                });
            } else {
                detailsContainer.innerHTML = '<div class="text-slate-400 text-sm py-4">Нет данных для отображения.</div>';
            }
        } catch (e) {
            detailsContainer.innerHTML = '<div class="text-red-400 text-sm py-4">Ошибка загрузки детализации.</div>';
        }
        
        lucide.createIcons();
    }

    function closeEditModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    async function saveSeoData() {
        const id = document.getElementById('edit_id').value;
        const btn = document.getElementById('saveBtn');
        const originalText = btn.innerHTML;
        
        btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Сохранение...';
        btn.disabled = true;
        lucide.createIcons();

        try {
            const res = await fetch('/admin/api/seo-detector/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: id,
                    seoTitle: document.getElementById('edit_seoTitle').value,
                    seoDescription: document.getElementById('edit_seoDescription').value,
                    teaser_text: document.getElementById('edit_teaserText').value,
                    full_analysis_markdown: document.getElementById('edit_fullAnalysis').value
                })
            });

            const data = await res.json();
            if (data.success) {
                // Перезагрузка страницы для обновления таблицы
                window.location.reload();
            } else {
                alert(data.error || 'Ошибка сохранения');
            }
        } catch (e) {
            alert('Сетевая ошибка');
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
            lucide.createIcons();
        }
    }

    async function rescanAll() {
        if (!confirm('Запустить массовый пересчет всех карточек в базе? Это может нагрузить сервер.')) return;
        
        const icon = document.getElementById('rescanIcon');
        icon.classList.add('animate-spin');
        
        try {
            const res = await fetch('/admin/api/seo-detector/rescan', { method: 'POST' });
            if (res.ok) {
                alert('Процесс запущен в фоновом режиме. Обновите страницу через минуту.');
            }
        } catch (e) {
            alert('Ошибка запуска');
        } finally {
            icon.classList.remove('animate-spin');
        }
    }
</script>

<%- include('admin_layout_footer') %>
