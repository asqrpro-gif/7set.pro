<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super-Admin | 7Set.Pro</title>
    <!-- Подключаем Tailwind (через CDN для админки) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .nav-item-base { transition: 0.2s; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="fixed bottom-0 left-0 right-0 z-50 w-full h-16 bg-[#1e293b] border-t border-slate-700 flex flex-row shrink-0 md:static md:w-64 md:h-auto md:flex-col md:border-t-0 md:border-r md:border-slate-700">
        <div class="hidden md:block p-6">
            <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                <i data-lucide="shield-alert" class="text-blue-500"></i> ROOT
            </h2>
        </div>
        <nav class="flex-1 flex flex-row items-center justify-around h-full md:flex-col md:justify-start md:overflow-y-auto px-1 md:px-2 py-0 md:py-2">
            <% const getNavClass = (isActive) => isActive ? 'bg-blue-500 text-white' : 'text-slate-400 hover:bg-blue-500 hover:text-white'; %>
            <% const baseClass = "nav-item-base flex items-center justify-center md:justify-start gap-2 rounded-lg p-2 md:px-4 md:py-3 mx-1 md:mx-2 md:mb-1 flex-1 md:flex-none h-12 md:h-auto"; %>
            
            <a href="/admin" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'dashboard' ? getNavClass(true) : getNavClass(false) %>" title="Дашборд">
                <i data-lucide="layout-dashboard"></i> <span class="hidden md:inline">Дашборд</span>
            </a>
            <a href="/admin/seo-ops" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'seo-ops' ? getNavClass(true) : getNavClass(false) %>" title="Управление">
                <i data-lucide="settings-2"></i> <span class="hidden md:inline">Управление</span>
            </a>
            <a href="/admin/seo-detector" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'seo-detector' ? getNavClass(true) : getNavClass(false) %>" title="SEO детектор">
                <i data-lucide="radar"></i> <span class="hidden md:inline">SEO детектор</span>
            </a>
            <a href="/admin/users" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'users' ? getNavClass(true) : getNavClass(false) %>" title="Пользователи">
                <i data-lucide="users"></i> <span class="hidden md:inline">Пользователи</span>
            </a>
            <a href="/" target="_blank" class="<%= baseClass %> md:mt-8 bg-slate-800 hover:bg-slate-700 text-slate-300 md:text-slate-400" title="На сайт">
                <i data-lucide="external-link"></i> <span class="hidden md:inline">На сайт</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-slate-900 relative w-full pb-[64px] md:pb-0">
        <header class="h-16 bg-slate-800 border-b border-slate-700 flex items-center px-4 md:px-8 shadow-sm shrink-0">
            <h1 class="text-lg md:text-xl font-semibold text-white truncate"><%= typeof title !== 'undefined' ? title : 'Панель управления' %></h1>
        </header>
        <div class="p-4 md:p-8 overflow-x-hidden">
