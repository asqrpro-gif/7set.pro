<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super-Admin | 7Set.Pro</title>
    <!-- Подключаем Tailwind (через CDN для админки) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        if(localStorage.getItem('admin_sidebar_collapsed') === 'true') {
            document.documentElement.classList.add('sidebar-collapsed');
        }
    </script>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .nav-item-base { transition: 0.2s; }
        #sidebar { transition: width 0.2s ease-in-out; }
        @media (min-width: 768px) {
            html.sidebar-collapsed #sidebar { width: 4rem; } /* w-16 = 64px */
            html.sidebar-collapsed .nav-text { display: none !important; }
            html.sidebar-collapsed .logo-wrapper { display: none !important; }
            html.sidebar-collapsed .nav-item-base { justify-content: center !important; padding-left: 0 !important; padding-right: 0 !important; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside id="sidebar" class="fixed bottom-0 left-0 right-0 z-50 w-full h-16 bg-[#1e293b] border-t border-slate-700 flex flex-row shrink-0 md:static md:w-40 md:h-auto md:flex-col md:border-t-0 md:border-r md:border-slate-700 overflow-hidden">
        <div class="logo-wrapper hidden md:flex justify-center p-4 border-b border-slate-700/50 mb-2 h-14 items-center shrink-0">
            <a href="/" target="_blank" title="Перейти на сайт" class="block hover:opacity-80 transition-opacity">
                <img src="/img/logo_7set_pro_152x22_px.webp" alt="7Set.Pro" class="h-4">
            </a>
        </div>
        <nav class="flex-1 flex flex-row items-center justify-around h-full md:flex-col md:justify-start md:overflow-y-auto px-1 md:px-2 py-0 md:py-1">
            <% const getNavClass = (isActive) => isActive ? 'bg-blue-500 text-white' : 'text-slate-400 hover:bg-slate-700 hover:text-white'; %>
            <% const baseClass = "nav-item-base flex items-center justify-center md:justify-start gap-3 rounded-lg p-2 md:px-3 md:py-2 mx-1 md:mx-0 md:mb-1 flex-1 md:flex-none h-12 md:h-auto text-xs md:text-sm font-medium w-full"; %>
            
            <a href="/admin" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'dashboard' ? getNavClass(true) : getNavClass(false) %>" title="Главная">
                <i data-lucide="layout-dashboard" class="w-5 h-5 md:w-4 md:h-4 shrink-0"></i> <span class="nav-text hidden md:inline">Главная</span>
            </a>
            <a href="/admin/seo-ops" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'seo-ops' ? getNavClass(true) : getNavClass(false) %>" title="Управление">
                <i data-lucide="settings-2" class="w-5 h-5 md:w-4 md:h-4 shrink-0"></i> <span class="nav-text hidden md:inline">Управление</span>
            </a>
            <a href="/admin/seo-detector" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'seo-detector' ? getNavClass(true) : getNavClass(false) %>" title="СЕО">
                <i data-lucide="radar" class="w-5 h-5 md:w-4 md:h-4 shrink-0"></i> <span class="nav-text hidden md:inline">СЕО</span>
            </a>
            <a href="/admin/users" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'users' ? getNavClass(true) : getNavClass(false) %>" title="Юзеры">
                <i data-lucide="users" class="w-5 h-5 md:w-4 md:h-4 shrink-0"></i> <span class="nav-text hidden md:inline">Юзеры</span>
            </a>
        </nav>
        
        <!-- Toggle button -->
        <button onclick="toggleSidebar()" class="hidden md:flex items-center justify-center p-2 text-slate-400 hover:text-white hover:bg-slate-700 m-2 mt-auto rounded-lg transition-colors shrink-0" title="Свернуть/Развернуть">
            <i data-lucide="panel-left-close" id="sidebar-toggle-icon" class="w-4 h-4"></i>
        </button>
    </aside>

    <script>
        function toggleSidebar() {
            const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            localStorage.setItem('admin_sidebar_collapsed', isCollapsed);
            
            const icon = document.getElementById('sidebar-toggle-icon');
            if(icon) {
                icon.setAttribute('data-lucide', isCollapsed ? 'panel-left-open' : 'panel-left-close');
                lucide.createIcons();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if(localStorage.getItem('admin_sidebar_collapsed') === 'true') {
                const icon = document.getElementById('sidebar-toggle-icon');
                if(icon) icon.setAttribute('data-lucide', 'panel-left-open');
                lucide.createIcons();
            }
        });
    </script>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-slate-900 relative w-full pb-[64px] md:pb-0">
        <header class="h-16 bg-slate-800 border-b border-slate-700 flex items-center px-4 md:px-8 shadow-sm shrink-0">
            <h1 class="text-lg md:text-xl font-semibold text-white truncate"><%= typeof title !== 'undefined' ? title : 'Панель управления' %></h1>
        </header>
        <div class="p-4 md:p-8 overflow-x-hidden">
