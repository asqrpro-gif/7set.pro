<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super-Admin | 7Set.Pro</title>
    <!-- Подключаем Tailwind (через CDN для админки) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        if(localStorage.getItem('admin_sidebar_collapsed') === 'true') {
            document.documentElement.classList.add('sidebar-collapsed');
        }
    </script>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; }
        .nav-item-base { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        @media (min-width: 768px) {
            html.sidebar-collapsed #sidebar { width: 4rem; } /* w-16 = 64px */
            html.sidebar-collapsed .nav-text { display: none !important; }
            html.sidebar-collapsed .logo-wrapper { display: none !important; }
            html.sidebar-collapsed .nav-item-base { justify-content: center !important; padding-left: 0 !important; padding-right: 0 !important; }
        }
        
        /* Скрытие скроллбара для мобильного меню */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="flex h-[100dvh] overflow-hidden">
    <!-- Sidebar / Bottom Nav -->
    <aside id="sidebar" class="fixed md:static bottom-3 left-3 right-3 z-50 h-16 md:h-auto md:w-40 bg-slate-800/80 md:bg-[#1e293b] backdrop-blur-xl md:backdrop-blur-none border border-slate-700/50 md:border-t-0 md:border-l-0 md:border-b-0 md:border-r md:border-slate-700 flex flex-row md:flex-col shrink-0 rounded-2xl md:rounded-none shadow-[0_8px_30px_rgb(0,0,0,0.4)] md:shadow-none overflow-visible md:overflow-hidden">
        <div class="logo-wrapper hidden md:flex justify-center p-4 border-b border-slate-700/50 mb-2 h-14 items-center shrink-0">
            <a href="/" target="_blank" title="Перейти на сайт" class="block hover:opacity-80 transition-opacity">
                <img src="/img/logo_7set_pro_152x22_px.webp" alt="7Set.Pro" class="h-4">
            </a>
        </div>
        <nav class="flex-1 flex flex-row md:flex-col items-center md:items-stretch justify-around md:justify-start h-full md:overflow-y-auto px-2 md:px-2 py-0 md:py-2 gap-1 md:gap-2">
            <% const getNavClass = (isActive) => isActive ? 'bg-blue-600 text-white shadow-[0_0_15px_rgba(37,99,235,0.3)] md:shadow-none' : 'text-slate-400 hover:bg-slate-700/50 hover:text-white'; %>
            <% const getIconClass = (isActive) => isActive ? 'text-white' : 'text-slate-400 group-hover:text-white'; %>
            <% const baseClass = "nav-item-base group flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 rounded-xl p-1 md:px-3 md:py-2.5 w-[60px] md:w-full h-[52px] md:h-auto text-[10px] md:text-sm font-medium relative"; %>
            
            <a href="/admin" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'dashboard' ? getNavClass(true) : getNavClass(false) %>" title="Главная">
                <i data-lucide="layout-template" class="w-5 h-5 md:w-4 md:h-4 shrink-0 transition-transform group-hover:scale-110 <%= typeof page !== 'undefined' && page === 'dashboard' ? getIconClass(true) : getIconClass(false) %>"></i> 
                <span class="nav-text md:inline">Главная</span>
            </a>

            <a href="/admin/seo-detector" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'seo-detector' ? getNavClass(true) : getNavClass(false) %>" title="СЕО">
                <i data-lucide="line-chart" class="w-5 h-5 md:w-4 md:h-4 shrink-0 transition-transform group-hover:scale-110 <%= typeof page !== 'undefined' && page === 'seo-detector' ? getIconClass(true) : getIconClass(false) %>"></i> 
                <span class="nav-text md:inline">СЕО</span>
            </a>
            <a href="/admin/users" class="<%= baseClass %> <%= typeof page !== 'undefined' && page === 'users' ? getNavClass(true) : getNavClass(false) %>" title="Юзеры">
                <i data-lucide="users-round" class="w-5 h-5 md:w-4 md:h-4 shrink-0 transition-transform group-hover:scale-110 <%= typeof page !== 'undefined' && page === 'users' ? getIconClass(true) : getIconClass(false) %>"></i> 
                <span class="nav-text md:inline">Юзеры</span>
            </a>
        </nav>
        
        <!-- Toggle button -->
        <button onclick="toggleSidebar()" class="hidden md:flex items-center justify-center p-2.5 text-slate-400 hover:text-white hover:bg-slate-700 m-2 mt-auto rounded-xl transition-colors shrink-0" title="Свернуть/Развернуть">
            <i data-lucide="panel-left-close" id="sidebar-toggle-icon" class="w-4 h-4"></i>
        </button>
    </aside>

    <script>
        function toggleSidebar() {
            const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            localStorage.setItem('admin_sidebar_collapsed', isCollapsed);
            
            const icon = document.getElementById('sidebar-toggle-icon');
            if(icon) {
                icon.setAttribute('data-lucide', isCollapsed ? 'panel-left-open' : 'panel-left-close');
                lucide.createIcons();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if(localStorage.getItem('admin_sidebar_collapsed') === 'true') {
                const icon = document.getElementById('sidebar-toggle-icon');
                if(icon) icon.setAttribute('data-lucide', 'panel-left-open');
                lucide.createIcons();
            }
        });
    </script>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-[100dvh] overflow-y-auto bg-slate-900 relative w-full pb-[88px] md:pb-0">
        <header class="h-14 md:h-16 bg-slate-800/95 backdrop-blur-sm border-b border-slate-700 flex items-center px-4 md:px-8 shadow-sm shrink-0 sticky top-0 z-40">
            <h1 class="text-base md:text-xl font-bold text-white truncate flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                <%= typeof title !== 'undefined' ? title : 'Панель управления' %>
            </h1>
        </header>
        <div class="p-3 md:p-6 overflow-x-hidden flex-1 flex flex-col min-h-0">

