<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seoTitle || `Коды ошибок ${brandName} ${modelName} - расшифровка на русском` %></title>
  <meta name="description" content="<%= seoDescription || `Список частых кодов ошибок (чек енджин) для ${brandName} ${modelName}. Узнайте значение ошибок OBD-II и дилерских кодов.` %>">
  <link rel="canonical" href="https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>/<%= encodeURIComponent(modelName.toLowerCase()) %>" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = { 
      darkMode: 'class', 
      theme: { extend: { colors: { brand: '#0077FF', surface: '#F5F5F7' } } } 
    }
  </script>
  <link rel="stylesheet" href="/style.css?v=2">
  <script src="/main.js?v=2" defer></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Schema.org JSON-LD Breadcrumbs -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://7set.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Архив марок",
        "item": "https://7set.pro/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= brandName %>",
        "item": "https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "<%= modelName %>",
        "item": "https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>/<%= encodeURIComponent(modelName.toLowerCase()) %>"
      }
    ]
  }
  </script>
</head>
<body class="bg-surface dark:bg-slate-900 text-gray-900 dark:text-white font-sans antialiased min-h-screen flex flex-col justify-between">
  <div class="max-w-5xl mx-auto p-4 md:p-6 w-full flex-grow">
    <!-- Шапка (Header) -->
    <%- include('partials/header') %>

    <main class="space-y-8">
      <!-- Хлебные крошки -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400 overflow-x-auto whitespace-nowrap pb-2">
          <li>
            <a href="/" class="hover:text-brand flex items-center transition-colors">
              <i data-lucide="home" class="w-4 h-4 mr-1"></i> Главная
            </a>
          </li>
          <li class="flex items-center space-x-2">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <a href="/catalog" class="hover:text-brand transition-colors">Архив</a>
          </li>
          <li class="flex items-center space-x-2">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <a href="/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>" class="hover:text-brand transition-colors capitalize"><%= brandName %></a>
          </li>
          <li class="flex items-center space-x-2" aria-current="page">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <span class="font-semibold text-gray-900 dark:text-white capitalize"><%= modelName %></span>
          </li>
        </ol>
      </nav>

      <!-- Контент Модели -->
      <section class="py-4">
        <div class="mb-8 text-center md:text-left">
            <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white capitalize">
              Коды ошибок <%= brandName %> <%= modelName %>
            </h1>
            <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-3xl mx-auto md:mx-0">
              База расшифрованных кодов неисправностей (OBD2) для <%= brandName %> <%= modelName %>. Нажмите на код ошибки для просмотра причины, стоимости ремонта и инструкций.
            </p>

            <form action="/search" method="GET" class="mt-8 relative w-full flex items-center bg-[#f8fafc] dark:bg-slate-900/40 border-[1.5px] border-slate-200 dark:border-slate-700/80 rounded-2xl p-1.5 focus-within:border-brand/50 focus-within:ring-4 focus-within:ring-brand/10 transition-all shadow-sm">
              <input type="hidden" name="brand" value="<%= brandName %>">
              <input type="hidden" name="model" value="<%= modelName %>">
              
              <!-- Поле ввода (с очисткой от глобальных стилей) -->
              <input type="text" name="code" placeholder="Поиск кода (напр. P0158)" required
                     class="w-full flex-1 outline-none focus:ring-0 text-gray-900 dark:text-white placeholder-gray-400 uppercase font-bold text-base md:text-lg min-w-0"
                     style="background-color: transparent !important; border: none !important; box-shadow: none !important; padding: 0 16px 0 20px !important; height: 48px !important; min-height: 48px !important; margin: 0 !important; width: 100% !important;">
              
              <!-- Компактная кнопка поиска -->
              <button type="submit" aria-label="Искать" class="shrink-0 flex items-center justify-center bg-brand hover:bg-blue-600 text-white rounded-xl transition-all shadow-sm border-none cursor-pointer hover:-translate-y-0.5 active:scale-95" style="width: 48px !important; height: 48px !important; min-width: 48px !important;">
                <i data-lucide="search" class="w-5 h-5"></i>
              </button>
            </form>
        </div>

        <% 
          const groupedCodes = {};
          codes.forEach(report => {
            const codeStr = report.code.toUpperCase();
            // Группировка по 4 символам (например, P015)
            const prefix = codeStr.length >= 4 ? codeStr.substring(0, 4) : codeStr;
            if (!groupedCodes[prefix]) {
              groupedCodes[prefix] = [];
            }
            groupedCodes[prefix].push(report);
          });
          const sortedPrefixes = Object.keys(groupedCodes).sort();
        %>

        <% if(codes.length === 0) { %>
          <div class="text-center py-10">
            <p class="text-gray-500 text-lg">Для этой модели пока нет кодов ошибок.</p>
          </div>
        <% } else { %>
          <div class="space-y-4 w-full">
            <% sortedPrefixes.forEach(function(prefix, index) { 
                const groupCodes = groupedCodes[prefix];
                const rangeStart = prefix.length === 4 ? prefix + '0' : prefix;
                const rangeEnd = prefix.length === 4 ? prefix + '9' : prefix;
                const groupTitle = prefix.length === 4 ? `Коды ${rangeStart} — ${rangeEnd}` : `Группа ${prefix}`;
            %>
              <details class="group w-full mb-4">
                <summary class="flex items-center justify-between py-3 px-4 md:px-6 cursor-pointer bg-white dark:bg-slate-800 border-[1.5px] border-gray-100 dark:border-slate-700 rounded-2xl shadow-sm hover:border-brand dark:hover:border-brand transition-colors list-none outline-none">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-brand/10 dark:bg-brand/20 flex items-center justify-center text-brand shadow-sm shrink-0">
                      <i data-lucide="folder-open" class="w-4 h-4"></i>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center gap-0.5 sm:gap-3">
                      <h2 class="font-bold text-base text-gray-900 dark:text-white leading-tight"><%= groupTitle %></h2>
                      <span class="text-[11px] sm:text-xs font-semibold text-gray-500 dark:text-gray-400 bg-gray-200/50 dark:bg-slate-800 px-2 py-0.5 rounded-md"><%= groupCodes.length %> шт.</span>
                    </div>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-white dark:bg-slate-800 flex items-center justify-center shadow-sm group-hover:bg-brand group-hover:text-white dark:group-hover:bg-brand transition-all shrink-0">
                    <i data-lucide="chevron-down" class="w-4 h-4 text-gray-500 dark:text-gray-400 group-hover:text-white group-open:rotate-180 transition-transform duration-300"></i>
                  </div>
                </summary>
                <div class="p-2 md:p-4 mt-2 bg-transparent">
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 mt-2">
                    <% groupCodes.forEach(function(report) { 
                        const link = `/catalog/${encodeURIComponent(brandName.toLowerCase())}/${encodeURIComponent(modelName.toLowerCase())}/${encodeURIComponent(report.code.toUpperCase())}`;
                        let summaryText = report.summary || 'Описание недоступно';
                        summaryText = summaryText.replace(/\n/g, ' ').substring(0, 80) + '...';

                        const severityMap = {
                          critical: { class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300', text: 'Критичный' },
                          high: { class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300', text: 'Высокий' },
                          medium: { class: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300', text: 'Средний' },
                          low: { class: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300', text: 'Низкий' }
                        };
                        const sev = severityMap[report.severity] || severityMap.medium;
                    %>
                      <a href="<%= link %>" class="bg-white dark:bg-slate-800 p-5 rounded-2xl border-[1.5px] border-[#0077FF] dark:border-[#0077FF] shadow-none hover:shadow-[0_0_25px_rgba(0,119,255,0.5)] transition-all flex flex-col h-full relative overflow-hidden duration-300 hover:-translate-y-1">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="font-black font-mono text-lg bg-brand text-white px-3 py-1 rounded-lg shadow-sm m-0"><%= report.code.toUpperCase() %></h3>
                            <span class="<%= sev.class %> text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider"><%= sev.text %></span>
                        </div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 line-clamp-3 leading-relaxed flex-grow">
                          <%= summaryText %>
                        </p>
                      </a>
                    <% }); %>
                  </div>
                </div>
              </details>
            <% }); %>
          </div>
        <% } %>
      </section>
    </main>

  </div>

  <!-- Подвал (Footer) -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 w-full">
    <%- include('partials/footer') %>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>
