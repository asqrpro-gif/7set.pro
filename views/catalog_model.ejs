<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seoTitle || `Коды ошибок ${brandName} ${modelName} - расшифровка на русском` %></title>
  <meta name="description" content="<%= seoDescription || `Список частых кодов ошибок (чек енджин) для ${brandName} ${modelName}. Узнайте значение ошибок OBD-II и дилерских кодов.` %>">
  <link rel="canonical" href="https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>/<%= encodeURIComponent(modelName.toLowerCase()) %>" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = { 
      darkMode: 'class', 
      theme: { extend: { colors: { brand: '#0077FF', surface: '#F5F5F7' } } } 
    }
  </script>
  <link rel="stylesheet" href="/style.css?v=2">
  <script src="/main.js?v=2" defer></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Schema.org JSON-LD Breadcrumbs -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://7set.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Каталог марок",
        "item": "https://7set.pro/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= brandName %>",
        "item": "https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "<%= modelName %>",
        "item": "https://7set.pro/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>/<%= encodeURIComponent(modelName.toLowerCase()) %>"
      }
    ]
  }
  </script>
</head>
<body class="bg-surface dark:bg-slate-900 text-gray-900 dark:text-white font-sans antialiased min-h-screen flex flex-col justify-between">
  <div class="max-w-5xl mx-auto p-4 md:p-6 w-full">
    <!-- Шапка -->
    <header class="flex justify-between items-center mb-6 bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700">
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <i data-lucide="activity" style="color: #007bff;"></i>
        <span class="font-bold text-xl tracking-tight text-gray-900 dark:text-white">7Set.Pro</span> <span class="font-normal text-sm text-gray-500 dark:text-gray-400 ml-1 hidden md:inline">| Умная автодиагностика</span>
      </a>
      <div class="flex items-center gap-3">
        <a href="/garage" class="text-sm font-semibold bg-brand/10 dark:bg-brand/20 text-brand dark:text-blue-400 px-3.5 py-2 rounded-xl hover:bg-brand hover:text-white dark:hover:bg-brand dark:hover:text-white transition-all flex items-center gap-1.5 shadow-sm">
          <i data-lucide="car" class="w-4 h-4"></i> Гараж
        </a>
        <button id="theme-toggle" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors" aria-label="Переключить тему">
          <i data-lucide="moon" class="w-5 h-5 text-gray-700 dark:text-gray-300"></i>
        </button>
      </div>
    </header>

    <main class="space-y-8">
      <!-- Хлебные крошки -->
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400 overflow-x-auto whitespace-nowrap pb-2">
          <li>
            <a href="/" class="hover:text-brand flex items-center transition-colors">
              <i data-lucide="home" class="w-4 h-4 mr-1"></i> Главная
            </a>
          </li>
          <li class="flex items-center space-x-2">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <a href="/" class="hover:text-brand transition-colors">Каталог</a>
          </li>
          <li class="flex items-center space-x-2">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <a href="/catalog/<%= encodeURIComponent(brandName.toLowerCase()) %>" class="hover:text-brand transition-colors capitalize"><%= brandName %></a>
          </li>
          <li class="flex items-center space-x-2" aria-current="page">
            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            <span class="font-semibold text-gray-900 dark:text-white capitalize"><%= modelName %></span>
          </li>
        </ol>
      </nav>

      <!-- Контент Модели -->
      <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-10 shadow-sm border border-gray-100 dark:border-slate-700">
        <div class="mb-8 text-center md:text-left">
            <h1 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white capitalize">
              Коды ошибок <%= brandName %> <%= modelName %>
            </h1>
            <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-3xl mx-auto md:mx-0">
              База расшифрованных кодов неисправностей (OBD2) для <%= brandName %> <%= modelName %>. Нажмите на код ошибки для просмотра причины, стоимости ремонта и инструкций.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
          <% codes.forEach(function(report) { 
              const link = `/catalog/${encodeURIComponent(brandName.toLowerCase())}/${encodeURIComponent(modelName.toLowerCase())}/${encodeURIComponent(report.code.toUpperCase())}`;
              let summaryText = report.summary || 'Описание недоступно';
              summaryText = summaryText.replace(/\n/g, ' ').substring(0, 80) + '...';

              const severityMap = {
                critical: { class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300', text: 'Критичный' },
                high: { class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300', text: 'Высокий' },
                medium: { class: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300', text: 'Средний' },
                low: { class: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300', text: 'Низкий' }
              };
              const sev = severityMap[report.severity] || severityMap.medium;
          %>
            <a href="<%= link %>" class="bg-surface dark:bg-slate-700/50 p-5 rounded-2xl border border-gray-100 dark:border-slate-600 shadow-sm hover:shadow-lg hover:border-brand/40 dark:hover:border-brand/40 transition-all group flex flex-col h-full relative overflow-hidden duration-300 hover:-translate-y-1">
              <div class="flex items-center justify-between mb-3">
                  <span class="font-black text-lg bg-brand text-white px-3 py-1 rounded-lg shadow-sm"><%= report.code.toUpperCase() %></span>
                  <span class="<%= sev.class %> text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider"><%= sev.text %></span>
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 line-clamp-3 leading-relaxed flex-grow">
                <%= summaryText %>
              </p>
            </a>
          <% }); %>
          <% if(codes.length === 0) { %>
            <p class="col-span-full text-center text-gray-500">Для этой модели пока нет кодов ошибок.</p>
          <% } %>
        </div>
      </section>
    </main>

    <!-- Подвал -->
    <footer class="mt-12 pt-8 border-t border-gray-200/80 dark:border-slate-700 text-xs text-gray-500 dark:text-gray-400">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>© <%= new Date().getFullYear() %> 7Set.pro. Все права защищены.</div>
        <div class="flex gap-4">
          <a href="/legal/terms" class="hover:text-brand transition-colors">Соглашение</a>
          <a href="/legal/privacy" class="hover:text-brand transition-colors">Конфиденциальность</a>
        </div>
      </div>
    </footer>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>
