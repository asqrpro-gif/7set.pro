generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DiagnosticReport {
  id                     String   @id @default(uuid())
  brand                  String
  model                  String
  code                   String
  severity               String
  summary                String   @db.Text
  teaser_text            String   @db.Text
  full_analysis_markdown String   @db.LongText
  sto_protection_tips    String   @db.Text
  is_paid                Boolean  @default(false)
  is_complete            Boolean  @default(true)
  drivability            String?
  seoTitle               String?  @db.Text
  seoDescription         String?  @db.Text
  popular_engine_codes   Json?
  related_obd_codes      Json?

  diy_difficulty_text    String?
  diy_difficulty_score   String?
  diy_time               String?
  diy_tools              String?  @db.Text
  price_parts            String?
  price_labor            String?
  diy_instructions       String?  @db.LongText

  diy_difficulty         String?
  diy_possible           Boolean?
  free_diagnosis         String?  @db.Text
  schema_faq             String?  @db.Text
  verdict                String?  @db.Text
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id])

  created_at             DateTime @default(now())
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  passwordHash String?
  role         String?            @default("user")
  planType     String             @default("single") // "single" (1 авто), "multi" (до 5 авто), "pro" (безлимит СТО)
  isSubscribed Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  carReports   DiagnosticReport[]
  cars         CarGarage[]
}

model CarGarage {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand           String   // Марка (например, Toyota)
  model           String   // Модель (например, Camry)
  engine          String   // Двигатель (например, 2.5 2AR-FE)
  year            Int      // Год выпуска
  // Кеш сгенерированных ИИ расходников для этого авто (щетки, масла, жидкости, фильтры)
  consumablesJson String   @db.LongText 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, brand, model, engine, year])
  @@index([userId])
}
